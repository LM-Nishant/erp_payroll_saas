  @@index([organizationId, itemId, date])
  @@index([organizationId, institutionId, date])
  @@map("inventory_transactions")
}

// ===== Academics & Exams =====

enum SubjectType {
  THEORY
  PRACTICAL
  ELECTIVE
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

enum ExamTermType {
  UNIT_TEST
  MID_TERM
  FINAL
  OTHER
}

enum ExamTermStatus {
  DRAFT
  SCHEDULED
  MARKS_ENTRY
  RESULTS_COMPUTED
  PUBLISHED
}

enum ExamMarksStatus {
  OPEN
  LOCKED
}

/// Subject taught in a program (curriculum). Marks defaults feed exam schedules.
model Subject {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  groupId        String?      @map("group_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  campusId       String?      @map("campus_id") @db.Char(36)
  departmentId   String       @map("department_id") @db.Char(36)
  programId      String       @map("program_id") @db.Char(36)
  code           String       @db.VarChar(32)
  name           String       @db.VarChar(200)
  type           SubjectType  @default(THEORY)
  credits        Decimal?     @db.Decimal(4, 1)
  maxMarks       Int          @default(100) @map("max_marks")
  passMarks      Int          @default(35) @map("pass_marks")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution      Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  program          Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  allocations      SubjectAllocation[]
  timetableEntries TimetableEntry[]
  examSchedules    ExamSchedule[]

  @@unique([programId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@index([organizationId, programId])
  @@index([organizationId, deletedAt])
  @@map("subjects")
}

/// Subject → teacher (user) allocation for a class section.
model SubjectAllocation {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  campusId       String?  @map("campus_id") @db.Char(36)
  departmentId   String   @map("department_id") @db.Char(36)
  classSectionId String   @map("class_section_id") @db.Char(36)
  subjectId      String   @map("subject_id") @db.Char(36)
  teacherUserId  String   @map("teacher_user_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher      User         @relation("SubjectAllocationTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)

  @@unique([classSectionId, subjectId])
  @@index([organizationId, teacherUserId])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@map("subject_allocations")
}

/// Class teacher (homeroom) of a section — marks daily attendance.
model ClassTeacherAssignment {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  campusId       String?  @map("campus_id") @db.Char(36)
  departmentId   String   @map("department_id") @db.Char(36)
  classSectionId String   @map("class_section_id") @db.Char(36)
  teacherUserId  String   @map("teacher_user_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  teacher      User         @relation("ClassTeacherUser", fields: [teacherUserId], references: [id], onDelete: Restrict)

  @@unique([classSectionId])
  @@index([organizationId, teacherUserId])
  @@index([organizationId, institutionId])
  @@map("class_teacher_assignments")
}

/// Bell schedule period of an institution (minutes from midnight).
model BellPeriod {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  seq            Int
  name           String   @db.VarChar(64)
  startTime      String   @map("start_time") @db.VarChar(5)
  endTime        String   @map("end_time") @db.VarChar(5)
  isBreak        Boolean  @default(false) @map("is_break")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  entries      TimetableEntry[]
  attendance   StudentAttendance[]

  @@unique([institutionId, seq])
  @@index([organizationId, institutionId])
  @@map("bell_periods")
}

/// Weekly timetable cell: section × day × period → subject, teacher, room.
model TimetableEntry {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  campusId       String?  @map("campus_id") @db.Char(36)
  departmentId   String   @map("department_id") @db.Char(36)
  classSectionId String   @map("class_section_id") @db.Char(36)
  dayOfWeek      Int      @map("day_of_week")
  periodId       String   @map("period_id") @db.Char(36)
  subjectId      String   @map("subject_id") @db.Char(36)
  teacherUserId  String?  @map("teacher_user_id") @db.Char(36)
  room           String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  classSection  ClassSection            @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  period        BellPeriod              @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subject       Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher       User?                   @relation("TimetableTeacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  substitutions TimetableSubstitution[]

  @@unique([classSectionId, dayOfWeek, periodId])
  @@index([organizationId, teacherUserId, dayOfWeek, periodId])
  @@index([organizationId, institutionId, room, dayOfWeek, periodId])
  @@index([organizationId, departmentId])
  @@map("timetable_entries")
}

/// One-day substitute teacher for a timetable entry.
model TimetableSubstitution {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  groupId          String?  @map("group_id") @db.Char(36)
  institutionId    String   @map("institution_id") @db.Char(36)
  campusId         String?  @map("campus_id") @db.Char(36)
  departmentId     String   @map("department_id") @db.Char(36)
  classSectionId   String   @map("class_section_id") @db.Char(36)
  entryId          String   @map("entry_id") @db.Char(36)
  date             DateTime @db.Date
  substituteUserId String   @map("substitute_user_id") @db.Char(36)
  reason           String?  @db.VarChar(500)
  createdByUserId  String?  @map("created_by_user_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry        TimetableEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  substitute   User           @relation("TimetableSubstitute", fields: [substituteUserId], references: [id], onDelete: Restrict)

  @@unique([entryId, date])
  @@index([organizationId, substituteUserId, date])
  @@index([organizationId, institutionId, date])
  @@map("timetable_substitutions")
}

/// Student attendance mark — daily (periodKey = '') or per bell period.
model StudentAttendance {
  id             String                  @id @default(uuid()) @db.Char(36)
  organizationId String                  @map("organization_id") @db.Char(36)
  groupId        String?                 @map("group_id") @db.Char(36)
  institutionId  String                  @map("institution_id") @db.Char(36)
  campusId       String?                 @map("campus_id") @db.Char(36)
  departmentId   String                  @map("department_id") @db.Char(36)
  classSectionId String                  @map("class_section_id") @db.Char(36)
  studentId      String                  @map("student_id") @db.Char(36)
  date           DateTime                @db.Date
  periodId       String?                 @map("period_id") @db.Char(36)
  periodKey      String                  @default("") @map("period_key") @db.VarChar(36)
  status         StudentAttendanceStatus
  remarks        String?                 @db.VarChar(500)
  markedByUserId String?                 @map("marked_by_user_id") @db.Char(36)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  period       BellPeriod?  @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([studentId, date, periodKey])
  @@index([organizationId, classSectionId, date])
  @@index([organizationId, institutionId, date])
  @@index([organizationId, departmentId])
  @@map("student_attendance")
}

/// Configurable grading scale (bands JSON: [{grade, minPercent, points, isPass}]).
model GradingScale {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  name           String    @db.VarChar(120)
  bands          Json
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  terms        ExamTerm[]

  @@index([organizationId, institutionId])
  @@index([organizationId, deletedAt])
  @@map("grading_scales")
}

/// Exam term (Unit test, Mid-term, Final) of an institution for an academic year.
model ExamTerm {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  groupId        String?        @map("group_id") @db.Char(36)
  institutionId  String         @map("institution_id") @db.Char(36)
  name           String         @db.VarChar(120)
  type           ExamTermType   @default(UNIT_TEST)
  academicYear   String         @map("academic_year") @db.VarChar(9)
  startDate      DateTime?      @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  gradingScaleId String?        @map("grading_scale_id") @db.Char(36)
  status         ExamTermStatus @default(DRAFT)
  publishedAt    DateTime?      @map("published_at") @db.DateTime(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?      @map("deleted_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  gradingScale GradingScale?  @relation(fields: [gradingScaleId], references: [id], onDelete: Restrict)
  schedules    ExamSchedule[]
  results      ExamResult[]

  @@unique([institutionId, academicYear, name])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, deletedAt])
  @@map("exam_terms")
}

/// Exam paper: term × section × subject with date and max/pass marks; marks lock state.
model ExamSchedule {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  groupId        String?         @map("group_id") @db.Char(36)
  institutionId  String          @map("institution_id") @db.Char(36)
  campusId       String?         @map("campus_id") @db.Char(36)
  departmentId   String          @map("department_id") @db.Char(36)
  termId         String          @map("term_id") @db.Char(36)
  classSectionId String          @map("class_section_id") @db.Char(36)
  subjectId      String          @map("subject_id") @db.Char(36)
  examDate       DateTime        @map("exam_date") @db.Date
  startTime      String?         @map("start_time") @db.VarChar(5)
  endTime        String?         @map("end_time") @db.VarChar(5)
  room           String?         @db.VarChar(64)
  maxMarks       Int             @map("max_marks")
  passMarks      Int             @map("pass_marks")
  marksStatus    ExamMarksStatus @default(OPEN) @map("marks_status")
  lockedAt       DateTime?       @map("locked_at") @db.DateTime(3)
  lockedByUserId String?         @map("locked_by_user_id") @db.Char(36)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  term         ExamTerm     @relation(fields: [termId], references: [id], onDelete: Restrict)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marks        ExamMark[]

  @@unique([termId, classSectionId, subjectId])
  @@index([organizationId, institutionId, examDate])
  @@index([organizationId, classSectionId])
  @@index([organizationId, departmentId])
  @@map("exam_schedules")
}

/// Marks of one student in one exam paper.
model ExamMark {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  institutionId   String   @map("institution_id") @db.Char(36)
  classSectionId  String   @map("class_section_id") @db.Char(36)
  scheduleId      String   @map("schedule_id") @db.Char(36)
  studentId       String   @map("student_id") @db.Char(36)
  marks           Decimal? @db.Decimal(6, 2)
  isAbsent        Boolean  @default(false) @map("is_absent")
  remarks         String?  @db.VarChar(500)
  enteredByUserId String?  @map("entered_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  schedule     ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, studentId])
  @@index([organizationId, studentId])
  @@map("exam_marks")
}

/// Computed term result of a student (subjects JSON = per-subject breakdown).
model ExamResult {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  campusId       String?   @map("campus_id") @db.Char(36)
  departmentId   String    @map("department_id") @db.Char(36)
  classSectionId String    @map("class_section_id") @db.Char(36)
  termId         String    @map("term_id") @db.Char(36)
  studentId      String    @map("student_id") @db.Char(36)
  totalMarks     Decimal   @map("total_marks") @db.Decimal(8, 2)
  maxTotal       Decimal   @map("max_total") @db.Decimal(8, 2)
  percentage     Decimal   @db.Decimal(5, 2)
  grade          String?   @db.VarChar(8)
  gpa            Decimal?  @db.Decimal(4, 2)
  rank           Int?
  passed         Boolean
  subjects       Json
  computedAt     DateTime  @map("computed_at") @db.DateTime(3)
  publishedAt    DateTime? @map("published_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  term         ExamTerm     @relation(fields: [termId], references: [id], onDelete: Restrict)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([termId, studentId])
  @@index([organizationId, classSectionId, termId])
  @@index([organizationId, studentId])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@map("exam_results")
}

// ===== Fees & Finance =====
// Layer: fees (modules/fees) + finance/accounts (modules/finance). Money = Decimal(14,2).
// Hierarchy FKs other than organization are scalar columns (like payroll) to keep the schema
// loosely coupled; services validate them through tenantDb (422 INVALID_REFERENCE).

/// Fee head (tuition, transport, hostel, library, exam, misc…). institutionId null = org-wide.
model FeeHead {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  groupId         String?   @map("group_id") @db.Char(36)
  institutionId   String?   @map("institution_id") @db.Char(36)
  code            String    @db.VarChar(32)
  name            String    @db.VarChar(200)
  category        String    @default("MISC") @db.VarChar(24)
  refundable      Boolean   @default(false)
  taxRate         Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  incomeAccountId String?   @map("income_account_id") @db.Char(36)
  sortOrder       Int       @default(0) @map("sort_order")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        FeeStructureItem[]
  invoiceLines FeeInvoiceLine[]
  concessions  FeeConcession[]

  @@unique([organizationId, institutionId, code])
  @@index([organizationId, institutionId, deletedAt])
  @@map("fee_heads")
}

/// Late-fee rule: FLAT once after grace, or PER_DAY after grace (capped by maxAmount).
model FeeLateRule {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  name           String    @db.VarChar(200)
  mode           String    @default("FLAT") @db.VarChar(16)
  amount         Decimal   @db.Decimal(14, 2)
  graceDays      Int       @default(0) @map("grace_days")
  maxAmount      Decimal?  @map("max_amount") @db.Decimal(14, 2)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  structures   FeeStructure[]

  @@index([organizationId, institutionId, deletedAt])
  @@map("fee_late_rules")
}

/// Fee structure for an institution (optionally narrowed to program / class section) and year.
model FeeStructure {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  campusId       String?   @map("campus_id") @db.Char(36)
  departmentId   String?   @map("department_id") @db.Char(36)
  programId      String?   @map("program_id") @db.Char(36)
  classSectionId String?   @map("class_section_id") @db.Char(36)
  academicYear   String    @map("academic_year") @db.VarChar(9)
  code           String    @db.VarChar(32)
  name           String    @db.VarChar(200)
  status         String    @default("ACTIVE") @db.VarChar(16)
  lateRuleId     String?   @map("late_rule_id") @db.Char(36)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  notes          String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lateRule     FeeLateRule?       @relation(fields: [lateRuleId], references: [id], onDelete: Restrict)
  installments FeeInstallment[]
  items        FeeStructureItem[]

  @@unique([organizationId, institutionId, academicYear, code])
  @@index([organizationId, institutionId, academicYear, deletedAt])
  @@index([organizationId, classSectionId])
  @@index([organizationId, programId])
  @@map("fee_structures")
}

/// Installment (term) of a structure with its due date.
model FeeInstallment {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  structureId    String   @map("structure_id") @db.Char(36)
  seq            Int
  label          String   @db.VarChar(120)
  dueDate        DateTime @map("due_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  structure    FeeStructure       @relation(fields: [structureId], references: [id], onDelete: Restrict)
  items        FeeStructureItem[]

  @@unique([structureId, seq])
  @@index([organizationId, structureId])
  @@map("fee_installments")
}

/// Amount of one fee head within one installment of a structure.
model FeeStructureItem {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  structureId    String   @map("structure_id") @db.Char(36)
  installmentId  String   @map("installment_id") @db.Char(36)
  feeHeadId      String   @map("fee_head_id") @db.Char(36)
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  structure    FeeStructure   @relation(fields: [structureId], references: [id], onDelete: Restrict)
  installment  FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  feeHead      FeeHead        @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([installmentId, feeHeadId])
  @@index([organizationId, structureId])
  @@map("fee_structure_items")
}

/// Concession / scholarship / sibling discount (PERCENT or AMOUNT per installment invoice).
model FeeConcession {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  groupId          String?   @map("group_id") @db.Char(36)
  institutionId    String    @map("institution_id") @db.Char(36)
  campusId         String?   @map("campus_id") @db.Char(36)
  departmentId     String?   @map("department_id") @db.Char(36)
  name             String    @db.VarChar(200)
  kind             String    @default("CONCESSION") @db.VarChar(16)
  appliesTo        String    @map("applies_to") @db.VarChar(16)
  studentId        String?   @map("student_id") @db.Char(36)
  category         String?   @db.VarChar(64)
  feeHeadId        String?   @map("fee_head_id") @db.Char(36)
  valueType        String    @map("value_type") @db.VarChar(16)
  value            Decimal   @db.Decimal(14, 2)
  academicYear     String?   @map("academic_year") @db.VarChar(9)
  reason           String?   @db.VarChar(500)
  active           Boolean   @default(true)
  approvedByUserId String?   @map("approved_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  feeHead      FeeHead?     @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@index([organizationId, institutionId, appliesTo, deletedAt])
  @@index([organizationId, studentId])
  @@map("fee_concessions")
}

/// Student fee invoice (demand): one per structure installment, ad-hoc, or module charge.
model FeeInvoice {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  groupId          String?   @map("group_id") @db.Char(36)
  institutionId    String    @map("institution_id") @db.Char(36)
  campusId         String?   @map("campus_id") @db.Char(36)
  departmentId     String?   @map("department_id") @db.Char(36)
  programId        String?   @map("program_id") @db.Char(36)
  classSectionId   String?   @map("class_section_id") @db.Char(36)
  studentId        String    @map("student_id") @db.Char(36)
  academicYear     String?   @map("academic_year") @db.VarChar(9)
  number           String    @db.VarChar(40)
  structureId      String?   @map("structure_id") @db.Char(36)
  installmentId    String?   @map("installment_id") @db.Char(36)
  sourceType       String    @default("ADHOC") @map("source_type") @db.VarChar(32)
  sourceId         String?   @map("source_id") @db.VarChar(64)
  dedupeKey        String?   @map("dedupe_key") @db.VarChar(191)
  description      String?   @db.VarChar(500)
  issueDate        DateTime  @map("issue_date") @db.Date
  dueDate          DateTime  @map("due_date") @db.Date
  grossAmount      Decimal   @default(0) @map("gross_amount") @db.Decimal(14, 2)
  concessionAmount Decimal   @default(0) @map("concession_amount") @db.Decimal(14, 2)
  taxAmount        Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lateFeeAmount    Decimal   @default(0) @map("late_fee_amount") @db.Decimal(14, 2)
  netAmount        Decimal   @default(0) @map("net_amount") @db.Decimal(14, 2)
  paidAmount       Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status           String    @default("UNPAID") @db.VarChar(16)
  lateRuleId       String?   @map("late_rule_id") @db.Char(36)
  lastReminderAt   DateTime? @map("last_reminder_at") @db.DateTime(3)
  cancelledAt      DateTime? @map("cancelled_at") @db.DateTime(3)
  cancelReason     String?   @map("cancel_reason") @db.VarChar(500)
  createdByUserId  String?   @map("created_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        FeeInvoiceLine[]
  allocations  FeePaymentAllocation[]

  @@unique([organizationId, institutionId, number])
  @@unique([organizationId, dedupeKey])
  @@index([organizationId, studentId, status])
  @@index([organizationId, institutionId, status, dueDate])
  @@index([organizationId, classSectionId, status])
  @@index([organizationId, sourceType, sourceId])
  @@map("fee_invoices")
}

model FeeInvoiceLine {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  invoiceId        String   @map("invoice_id") @db.Char(36)
  feeHeadId        String   @map("fee_head_id") @db.Char(36)
  description      String?  @db.VarChar(500)
  amount           Decimal  @db.Decimal(14, 2)
  concessionAmount Decimal  @default(0) @map("concession_amount") @db.Decimal(14, 2)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  netAmount        Decimal  @map("net_amount") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      FeeInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceId])
  @@index([organizationId, feeHeadId])
  @@map("fee_invoice_lines")
}

/// Fee payment = receipt. Allocated to invoices; unallocated remainder is an advance.
model FeePayment {
  id                String    @id @default(uuid()) @db.Char(36)
  organizationId    String    @map("organization_id") @db.Char(36)
  groupId           String?   @map("group_id") @db.Char(36)
  institutionId     String    @map("institution_id") @db.Char(36)
  campusId          String?   @map("campus_id") @db.Char(36)
  departmentId      String?   @map("department_id") @db.Char(36)
  studentId         String    @map("student_id") @db.Char(36)
  number            String    @db.VarChar(40)
  paidOn            DateTime  @map("paid_on") @db.Date
  mode              String    @db.VarChar(16)
  reference         String?   @db.VarChar(120)
  instrumentDate    DateTime? @map("instrument_date") @db.Date
  bankName          String?   @map("bank_name") @db.VarChar(120)
  amount            Decimal   @db.Decimal(14, 2)
  allocatedAmount   Decimal   @default(0) @map("allocated_amount") @db.Decimal(14, 2)
  refundedAmount    Decimal   @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  status            String    @default("ACTIVE") @db.VarChar(24)
  gatewayOrderId    String?   @map("gateway_order_id") @db.Char(36)
  voucherId         String?   @map("voucher_id") @db.Char(36)
  remarks           String?   @db.VarChar(500)
  collectedByUserId String?   @map("collected_by_user_id") @db.Char(36)
  cancelledAt       DateTime? @map("cancelled_at") @db.DateTime(3)
  cancelReason      String?   @map("cancel_reason") @db.VarChar(500)
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  allocations  FeePaymentAllocation[]
  refunds      FeeRefund[]

  @@unique([organizationId, institutionId, number])
  @@index([organizationId, studentId, status])
  @@index([organizationId, institutionId, paidOn])
  @@map("fee_payments")
}

model FeePaymentAllocation {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  paymentId      String   @map("payment_id") @db.Char(36)
  invoiceId      String   @map("invoice_id") @db.Char(36)
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      FeePayment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice      FeeInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([organizationId, invoiceId])
  @@map("fee_payment_allocations")
}

model FeeRefund {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  groupId          String?  @map("group_id") @db.Char(36)
  institutionId    String   @map("institution_id") @db.Char(36)
  campusId         String?  @map("campus_id") @db.Char(36)
  departmentId     String?  @map("department_id") @db.Char(36)
  paymentId        String   @map("payment_id") @db.Char(36)
  studentId        String   @map("student_id") @db.Char(36)
  number           String   @db.VarChar(40)
  refundedOn       DateTime @map("refunded_on") @db.Date
  amount           Decimal  @db.Decimal(14, 2)
  mode             String   @db.VarChar(16)
  reference        String?  @db.VarChar(120)
  reason           String   @db.VarChar(500)
  voucherId        String?  @map("voucher_id") @db.Char(36)
  refundedByUserId String?  @map("refunded_by_user_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      FeePayment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, institutionId, number])
  @@index([organizationId, studentId])
  @@map("fee_refunds")
}

/// Per-institution document number series (INVOICE, RECEIPT, REFUND, VOUCHER, EXPENSE).
model FinanceNumberSeries {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  kind           String   @db.VarChar(16)
  prefix         String   @db.VarChar(24)
  nextValue      Int      @default(1) @map("next_value")
  padding        Int      @default(5)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, institutionId, kind])
  @@map("finance_number_series")
}

/// Online payment order created through a payment gateway (checkout → webhook → receipt).
model PaymentGatewayOrder {
  id                String    @id @default(uuid()) @db.Char(36)
  organizationId    String    @map("organization_id") @db.Char(36)
  groupId           String?   @map("group_id") @db.Char(36)
  institutionId     String    @map("institution_id") @db.Char(36)
  campusId          String?   @map("campus_id") @db.Char(36)
  departmentId      String?   @map("department_id") @db.Char(36)
  studentId         String    @map("student_id") @db.Char(36)
  provider          String    @db.VarChar(32)
  providerOrderId   String    @map("provider_order_id") @db.VarChar(120)
  providerPaymentId String?   @map("provider_payment_id") @db.VarChar(120)
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("INR") @db.VarChar(3)
  invoiceIds        Json      @map("invoice_ids")
  status            String    @default("CREATED") @db.VarChar(16)
  paymentId         String?   @map("payment_id") @db.Char(36)
  initiatedByUserId String?   @map("initiated_by_user_id") @db.Char(36)
  failureReason     String?   @map("failure_reason") @db.VarChar(500)
  completedAt       DateTime? @map("completed_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([provider, providerOrderId])
  @@index([organizationId, studentId, status])
  @@map("payment_gateway_orders")
}

/// Chart of accounts (org-wide tree). systemKey marks accounts used by auto-posting.
model LedgerAccount {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  parentId       String?   @map("parent_id") @db.Char(36)
  code           String    @db.VarChar(32)
  name           String    @db.VarChar(200)
  type           String    @db.VarChar(16)
  isGroup        Boolean   @default(false) @map("is_group")
  systemKey      String?   @map("system_key") @db.VarChar(48)
  description    String?   @db.VarChar(500)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       LedgerAccount?  @relation("LedgerAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     LedgerAccount[] @relation("LedgerAccountTree")
  lines        JournalLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@index([organizationId, parentId])
  @@map("ledger_accounts")
}

/// Double-entry journal voucher (per institution). Auto-posted vouchers carry sourceType/Id.
model JournalVoucher {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  groupId         String?   @map("group_id") @db.Char(36)
  institutionId   String    @map("institution_id") @db.Char(36)
  campusId        String?   @map("campus_id") @db.Char(36)
  departmentId    String?   @map("department_id") @db.Char(36)
  number          String    @db.VarChar(40)
  voucherDate     DateTime  @map("voucher_date") @db.Date
  type            String    @default("JOURNAL") @db.VarChar(16)
  narration       String?   @db.VarChar(1000)
  status          String    @default("DRAFT") @db.VarChar(16)
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  sourceType      String    @default("MANUAL") @map("source_type") @db.VarChar(32)
  sourceId        String?   @map("source_id") @db.VarChar(64)
  sourceKey       String?   @map("source_key") @db.VarChar(191)
  postedAt        DateTime? @map("posted_at") @db.DateTime(3)
  postedByUserId  String?   @map("posted_by_user_id") @db.Char(36)
  cancelledAt     DateTime? @map("cancelled_at") @db.DateTime(3)
  cancelReason    String?   @map("cancel_reason") @db.VarChar(500)
  createdByUserId String?   @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([organizationId, institutionId, number])
  @@unique([organizationId, sourceKey])
  @@index([organizationId, institutionId, voucherDate, status])
  @@index([organizationId, sourceType, sourceId])
  @@map("journal_vouchers")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  voucherId      String   @map("voucher_id") @db.Char(36)
  accountId      String   @map("account_id") @db.Char(36)
  lineNo         Int      @map("line_no")
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  narration      String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  voucher      JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  account      LedgerAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId, accountId])
  @@index([organizationId, voucherId])
  @@map("journal_lines")
}

model Vendor {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String?   @map("institution_id") @db.Char(36)
  code           String    @db.VarChar(32)
  name           String    @db.VarChar(200)
  gstin          String?   @db.VarChar(20)
  phone          String?   @db.VarChar(32)
  email          String?   @db.VarChar(254)
  address        String?   @db.VarChar(500)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@unique([organizationId, code])
  @@index([organizationId, institutionId, deletedAt])
  @@map("vendors")
}

/// Expense / vendor payment: posts Dr expense account, Cr cash/bank.
model Expense {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  groupId          String?   @map("group_id") @db.Char(36)
  institutionId    String    @map("institution_id") @db.Char(36)
  campusId         String?   @map("campus_id") @db.Char(36)
  departmentId     String?   @map("department_id") @db.Char(36)
  number           String    @db.VarChar(40)
  expenseDate      DateTime  @map("expense_date") @db.Date
  vendorId         String?   @map("vendor_id") @db.Char(36)
  expenseAccountId String    @map("expense_account_id") @db.Char(36)
  paymentAccountId String    @map("payment_account_id") @db.Char(36)
  amount           Decimal   @db.Decimal(14, 2)
  mode             String    @db.VarChar(16)
  reference        String?   @db.VarChar(120)
  description      String    @db.VarChar(500)
  status           String    @default("POSTED") @db.VarChar(16)
  voucherId        String?   @map("voucher_id") @db.Char(36)
  cancelledAt      DateTime? @map("cancelled_at") @db.DateTime(3)
  cancelReason     String?   @map("cancel_reason") @db.VarChar(500)
  createdByUserId  String?   @map("created_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, institutionId, number])
  @@index([organizationId, institutionId, expenseDate])
  @@map("expenses")
}

// ===== Transport & Hostel =====
// Transport (feature `transport`) and hostel (feature `hostel`) modules. Students/employees/
// institutions are referenced by scalar ids (validated through tenantDb in the services) so the
// core models stay untouched; all intra-module links are real FKs (onDelete Restrict).

/// A school bus/van. Expiry dates drive the `transport.vehicle_document_expiring` reminders.
model TransportVehicle {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  groupId         String?   @map("group_id") @db.Char(36)
  institutionId   String    @map("institution_id") @db.Char(36)
  regNo           String    @map("reg_no") @db.VarChar(32)
  vehicleType     String    @default("BUS") @map("vehicle_type") @db.VarChar(16)
  make            String?   @db.VarChar(80)
  capacity        Int
  gpsDeviceId     String?   @map("gps_device_id") @db.VarChar(64)
  insuranceExpiry DateTime? @map("insurance_expiry") @db.Date
  fitnessExpiry   DateTime? @map("fitness_expiry") @db.Date
  permitExpiry    DateTime? @map("permit_expiry") @db.Date
  pollutionExpiry DateTime? @map("pollution_expiry") @db.Date
  nextServiceDate DateTime? @map("next_service_date") @db.Date
  odometerKm      Int?      @map("odometer_km")
  status          String    @default("ACTIVE") @db.VarChar(16)
  notes           String?   @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  staff        TransportStaff[]
  routes       TransportRoute[]
  trips        TransportTrip[]
  incidents    TransportIncident[]
  fuelLogs     TransportFuelLog[]
  maintenance  TransportMaintenanceLog[]

  @@unique([organizationId, regNo])
  @@index([organizationId, institutionId, status])
  @@map("transport_vehicles")
}

/// Driver / conductor / attendant, optionally linked to an HR employee.
model TransportStaff {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  employeeId     String?   @map("employee_id") @db.Char(36)
  role           String    @default("DRIVER") @db.VarChar(16)
  name           String    @db.VarChar(200)
  phone          String?   @db.VarChar(32)
  licenceNo      String?   @map("licence_no") @db.VarChar(40)
  licenceExpiry  DateTime? @map("licence_expiry") @db.Date
  vehicleId      String?   @map("vehicle_id") @db.Char(36)
  status         String    @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle        TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  drivenRoutes   TransportRoute[]  @relation("RouteDriver")
  attendedRoutes TransportRoute[]  @relation("RouteAttendant")
  trips          TransportTrip[]

  @@index([organizationId, institutionId, role, status])
  @@index([organizationId, employeeId])
  @@map("transport_staff")
}

model TransportRoute {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  code           String    @db.VarChar(32)
  name           String    @db.VarChar(160)
  vehicleId      String?   @map("vehicle_id") @db.Char(36)
  driverId       String?   @map("driver_id") @db.Char(36)
  attendantId    String?   @map("attendant_id") @db.Char(36)
  distanceKm     Decimal?  @map("distance_km") @db.Decimal(8, 2)
  status         String    @default("ACTIVE") @db.VarChar(16)
  notes          String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle      TransportVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver       TransportStaff?       @relation("RouteDriver", fields: [driverId], references: [id], onDelete: Restrict)
  attendant    TransportStaff?       @relation("RouteAttendant", fields: [attendantId], references: [id], onDelete: Restrict)
  stops        TransportStop[]
  allocations  TransportAllocation[]
  trips        TransportTrip[]
  incidents    TransportIncident[]

  @@unique([organizationId, institutionId, code])
  @@index([organizationId, institutionId, status])
  @@map("transport_routes")
}

/// Ordered stop on a route. `fareAmount` overrides the distance fare slab.
model TransportStop {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  routeId        String    @map("route_id") @db.Char(36)
  sequence       Int
  name           String    @db.VarChar(160)
  pickupTime     String?   @map("pickup_time") @db.VarChar(5)
  dropTime       String?   @map("drop_time") @db.VarChar(5)
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  distanceKm     Decimal?  @map("distance_km") @db.Decimal(8, 2)
  fareAmount     Decimal?  @map("fare_amount") @db.Decimal(12, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  route        TransportRoute        @relation(fields: [routeId], references: [id], onDelete: Restrict)
  allocations  TransportAllocation[]

  @@index([organizationId, routeId, sequence])
  @@map("transport_stops")
}

/// Distance-based fee slab (per institution): a stop at `distanceKm` in (minKm, maxKm] pays `amount`.
model TransportFareSlab {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  name           String   @db.VarChar(80)
  minKm          Decimal  @map("min_km") @db.Decimal(8, 2)
  maxKm          Decimal  @map("max_km") @db.Decimal(8, 2)
  amount         Decimal  @db.Decimal(12, 2)
  frequency      String   @default("MONTHLY") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, institutionId, minKm])
  @@map("transport_fare_slabs")
}

/// A student's or staff member's seat on a route/stop for a date range.
model TransportAllocation {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  passengerType  String    @map("passenger_type") @db.VarChar(16)
  studentId      String?   @map("student_id") @db.Char(36)
  employeeId     String?   @map("employee_id") @db.Char(36)
  routeId        String    @map("route_id") @db.Char(36)
  stopId         String    @map("stop_id") @db.Char(36)
  tripType       String    @default("BOTH") @map("trip_type") @db.VarChar(8)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  status         String    @default("ACTIVE") @db.VarChar(16)
  fareAmount     Decimal   @default(0) @map("fare_amount") @db.Decimal(12, 2)
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  route        TransportRoute      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop         TransportStop       @relation(fields: [stopId], references: [id], onDelete: Restrict)
  charges      TransportCharge[]
  boardings    TransportBoarding[]

  @@index([organizationId, institutionId, status])
  @@index([organizationId, routeId, status])
  @@index([organizationId, studentId, status])
  @@index([organizationId, employeeId, status])
  @@map("transport_allocations")
}

/// Transport fee charge per allocation per period (YYYY-MM). Posted to the fees module when present.
model TransportCharge {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  allocationId   String   @map("allocation_id") @db.Char(36)
  studentId      String?  @map("student_id") @db.Char(36)
  employeeId     String?  @map("employee_id") @db.Char(36)
  period         String   @db.VarChar(7)
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("PENDING") @db.VarChar(16)
  externalRef    String?  @map("external_ref") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  allocation   TransportAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@unique([allocationId, period])
  @@index([organizationId, institutionId, period, status])
  @@map("transport_charges")
}

/// One run of a route on a date (PICKUP or DROP) — the daily log.
model TransportTrip {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  groupId         String?   @map("group_id") @db.Char(36)
  institutionId   String    @map("institution_id") @db.Char(36)
  routeId         String    @map("route_id") @db.Char(36)
  vehicleId       String?   @map("vehicle_id") @db.Char(36)
  driverId        String?   @map("driver_id") @db.Char(36)
  tripDate        DateTime  @map("trip_date") @db.Date
  direction       String    @db.VarChar(8)
  status          String    @default("SCHEDULED") @db.VarChar(16)
  startedAt       DateTime? @map("started_at") @db.DateTime(3)
  endedAt         DateTime? @map("ended_at") @db.DateTime(3)
  startOdometerKm Int?      @map("start_odometer_km")
  endOdometerKm   Int?      @map("end_odometer_km")
  delayMinutes    Int?      @map("delay_minutes")
  notes           String?   @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  route        TransportRoute      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicle      TransportVehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver       TransportStaff?     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  boardings    TransportBoarding[]
  incidents    TransportIncident[]

  @@unique([routeId, tripDate, direction])
  @@index([organizationId, institutionId, tripDate])
  @@map("transport_trips")
}

model TransportBoarding {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  tripId         String    @map("trip_id") @db.Char(36)
  allocationId   String    @map("allocation_id") @db.Char(36)
  status         String    @db.VarChar(16)
  recordedAt     DateTime? @map("recorded_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trip         TransportTrip       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  allocation   TransportAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@unique([tripId, allocationId])
  @@index([organizationId, allocationId])
  @@map("transport_boardings")
}

model TransportIncident {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  groupId          String?  @map("group_id") @db.Char(36)
  institutionId    String   @map("institution_id") @db.Char(36)
  tripId           String?  @map("trip_id") @db.Char(36)
  routeId          String?  @map("route_id") @db.Char(36)
  vehicleId        String?  @map("vehicle_id") @db.Char(36)
  occurredAt       DateTime @map("occurred_at") @db.DateTime(3)
  severity         String   @default("LOW") @db.VarChar(16)
  title            String   @db.VarChar(200)
  description      String?  @db.VarChar(2000)
  status           String   @default("OPEN") @db.VarChar(16)
  resolution       String?  @db.VarChar(1000)
  reportedByUserId String?  @map("reported_by_user_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trip         TransportTrip?    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  route        TransportRoute?   @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicle      TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([organizationId, institutionId, occurredAt])
  @@map("transport_incidents")
}

model TransportFuelLog {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  vehicleId      String   @map("vehicle_id") @db.Char(36)
  logDate        DateTime @map("log_date") @db.Date
  litres         Decimal  @db.Decimal(10, 2)
  amount         Decimal  @db.Decimal(12, 2)
  odometerKm     Int?     @map("odometer_km")
  vendor         String?  @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle      TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([organizationId, vehicleId, logDate])
  @@index([organizationId, institutionId, logDate])
  @@map("transport_fuel_logs")
}

/// Service / repair record. `nextServiceDate` feeds the vehicle's service reminder.
model TransportMaintenanceLog {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  groupId         String?   @map("group_id") @db.Char(36)
  institutionId   String    @map("institution_id") @db.Char(36)
  vehicleId       String    @map("vehicle_id") @db.Char(36)
  serviceDate     DateTime  @map("service_date") @db.Date
  kind            String    @default("SERVICE") @db.VarChar(16)
  description     String    @db.VarChar(1000)
  cost            Decimal   @default(0) @db.Decimal(12, 2)
  odometerKm      Int?      @map("odometer_km")
  vendor          String?   @db.VarChar(120)
  nextServiceDate DateTime? @map("next_service_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle      TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([organizationId, vehicleId, serviceDate])
  @@index([organizationId, institutionId, serviceDate])
  @@map("transport_maintenance_logs")
}

model Hostel {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  groupId          String?   @map("group_id") @db.Char(36)
  institutionId    String    @map("institution_id") @db.Char(36)
  code             String    @db.VarChar(32)
  name             String    @db.VarChar(160)
  hostelType       String    @map("hostel_type") @db.VarChar(16)
  wardenEmployeeId String?   @map("warden_employee_id") @db.Char(36)
  wardenUserId     String?   @map("warden_user_id") @db.Char(36)
  phone            String?   @db.VarChar(32)
  address          String?   @db.VarChar(500)
  status           String    @default("ACTIVE") @db.VarChar(16)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  blocks       HostelBlock[]
  rooms        HostelRoom[]
  beds         HostelBed[]
  allocations  HostelAllocation[]
  messPlans    HostelMessPlan[]
  visitors     HostelVisitor[]
  outpasses    HostelOutpass[]
  movements    HostelMovement[]
  complaints   HostelComplaint[]
  rollCalls    HostelRollCall[]

  @@unique([organizationId, institutionId, code])
  @@index([organizationId, institutionId, status])
  @@map("hostels")
}

model HostelBlock {
