  category       String?   @db.VarChar(80)
  unit           String    @default("pcs") @db.VarChar(24)
  quantity       Decimal   @default(0) @db.Decimal(14, 2)
  reorderLevel   Decimal   @default(0) @map("reorder_level") @db.Decimal(14, 2)
  unitCost       Decimal?  @map("unit_cost") @db.Decimal(14, 2)
  location       String?   @db.VarChar(200)
  notes          String?   @db.VarChar(1000)
