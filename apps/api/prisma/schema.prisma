  institutionId        String                   @map("institution_id") @db.Char(36)
  campusId             String?                  @map("campus_id") @db.Char(36)
  departmentId         String?                  @map("department_id") @db.Char(36)
  ticketNo             String                   @map("ticket_no") @db.VarChar(40)
  type                 AssetMaintenanceType     @default(REPAIR)
  priority             AssetMaintenancePriority @default(MEDIUM)
  status               AssetMaintenanceStatus   @default(OPEN)
  title                String                   @db.VarChar(200)
  description          String?                  @db.VarChar(2000)
  vendor               String?                  @db.VarChar(200)
  scheduledDate        DateTime?                @map("scheduled_date") @db.Date
  startedAt            DateTime?                @map("started_at") @db.DateTime(3)
  completedAt          DateTime?                @map("completed_at") @db.Date
  cost                 Decimal                  @default(0) @db.Decimal(14, 2)
  underWarranty        Boolean                  @default(false) @map("under_warranty")
  resolution           String?                  @db.VarChar(2000)
  nextServiceDate      DateTime?                @map("next_service_date") @db.Date
