// Education ERP — Prisma schema (MySQL 8)
//
// Conventions (binding for all layers, see docs/ARCHITECTURE.md):
//  * Primary keys are UUID v4 strings stored as CHAR(36).
//  * Every tenant-owned table carries `organization_id` (the tenant id) plus the
//    hierarchy FKs relevant to it, and is indexed on (organization_id, ...).
//  * All tables have created_at / updated_at; business tables are soft-deleted via deleted_at.
//  * Table & column names are snake_case (@@map / @map); Prisma fields are camelCase.
//  * Any new tenant-owned model MUST be registered in src/core/tenancy/tenant-models.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationKind {
  EDUCATION
  COMPANY
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  INSTITUTE
  COMPANY
  BRANCH
}

enum ProgramLevel {
  PRE_PRIMARY
  PRIMARY
  SECONDARY
  HIGHER_SECONDARY
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  CERTIFICATE
  OTHER
}

/// Platform tenant root. One organization = one SaaS customer (an education group,
/// an education society, or an independent institution). Not tenant-scoped itself.
model Organization {
  id        String             @id @default(uuid()) @db.Char(36)
  name      String             @db.VarChar(200)
  slug      String             @unique @db.VarChar(64)
  status    OrganizationStatus @default(ACTIVE)
  /// EDUCATION shows school/college terminology; COMPANY hides education menus and labels.
  kind      OrganizationKind   @default(EDUCATION)
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime?          @map("deleted_at") @db.DateTime(3)

  // Academics & Exams
  subjects                Subject[]
  subjectAllocations      SubjectAllocation[]
  classTeacherAssignments ClassTeacherAssignment[]
  bellPeriods             BellPeriod[]
  timetableEntries        TimetableEntry[]
  timetableSubstitutions  TimetableSubstitution[]
  studentAttendance       StudentAttendance[]
  gradingScales           GradingScale[]
  examTerms               ExamTerm[]
  examSchedules           ExamSchedule[]
  examMarks               ExamMark[]
  examResults             ExamResult[]

  groups                    Group[]
  institutions              Institution[]
  campuses                  Campus[]
  departments               Department[]
  programs                  Program[]
  classSections             ClassSection[]
  studentCodeSequences      StudentCodeSequence[]
  students                  Student[]
  studentEnrollments        StudentEnrollment[]
  guardians                 Guardian[]
  studentGuardians          StudentGuardian[]
  admissionApplications     AdmissionApplication[]
  memberships               OrganizationMembership[]
  roles                     Role[]
  rolePermissions           RolePermission[]
  userRoles                 UserRole[]
  userScopes                UserScope[]
  authSessions              AuthSession[]
  loginEvents               LoginEvent[]
  userTokens                UserToken[]
  auditLogs                 AuditLog[]
  subscription              OrganizationSubscription?
  invoices                  Invoice[]
  featureOverrides          FeatureOverride[]
  usageCounters             UsageCounter[]
  brandingProfiles          BrandingProfile[]
  secrets                   TenantSecret[]
  employeeTypes             EmployeeType[]
  documents                 Document[]
  documentVersions          DocumentVersion[]
  documentGrants            DocumentPermission[]
  documentReminders         DocumentExpiryReminder[]
  documentSignatures        DocumentSignature[]
  storageUploads            StorageUpload[]
  // Layer 5 engines
  workflowDefinitions       WorkflowDefinition[]
  workflowInstances         WorkflowInstance[]
  workflowStepInstances     WorkflowStepInstance[]
  workflowStepAssignees     WorkflowStepAssignee[]
  workflowActions           WorkflowAction[]
  notifications             Notification[]
  notificationRules         NotificationRule[]
  notificationJobs          NotificationJob[]
  notificationPreferences   NotificationPreference[]
  pushDevices               PushDevice[]
  communicationProviders    CommunicationProvider[]
  messageTemplates          MessageTemplate[]
  messageTemplateVersions   MessageTemplateVersion[]
  messageLogs               MessageLog[]
  deliveryEvents            DeliveryEvent[]
  campaigns                 Campaign[]
  campaignRecipients        CampaignRecipient[]
  apiClients                ApiClient[]
  apiScopes                 ApiScope[]
  apiUsage                  ApiUsage[]
  domainEvents              DomainEvent[]
  webhooks                  Webhook[]
  webhookEvents             WebhookEvent[]
  integrationCredentials    IntegrationCredential[]
  // Layer 6 HR
  designations              Designation[]
  employeeCodeSequences     EmployeeCodeSequence[]
  employees                 Employee[]
  employeeProfiles          EmployeeProfile[]
  employeePositions         EmployeePosition[]
  employeeDepartments       EmployeeDepartment[]
  employeeReportingLines    EmployeeReportingLine[]
  employeeMovements         EmployeeMovement[]
  employeeSalaryHistory     EmployeeSalaryHistory[]
  employeeChecklistItems    EmployeeChecklistItem[]
  employeeChangeRequests    EmployeeProfileChangeRequest[]
  employeeImportJobs        EmployeeImportJob[]
  holidayCalendars          HolidayCalendar[]
  holidays                  Holiday[]
  shifts                    Shift[]
  shiftAssignments          ShiftAssignment[]
  attendancePunches         AttendancePunch[]
  attendanceRecords         AttendanceRecord[]
  attendanceRegularizations AttendanceRegularization[]
  attendancePeriodLocks     AttendancePeriodLock[]
  attendancePolicies        AttendancePolicy[]
  attendanceImportJobs      AttendanceImportJob[]
  leaveTypes                LeaveType[]
  leavePolicies             LeavePolicy[]
  leavePolicyRules          LeavePolicyRule[]
  leaveLedgerEntries        LeaveLedgerEntry[]
  leaveRequests             LeaveRequest[]
  // Layer 8 Payroll
  salaryComponents          SalaryComponent[]
  salaryRules               SalaryRule[]
  salaryStructures          SalaryStructure[]
  salaryStructureVersions   SalaryStructureVersion[]
  payrollSettings           PayrollSetting[]
  statutoryRulePacks        StatutoryRulePack[]
  employeeSalaries          EmployeeSalary[]
  salaryRevisions           SalaryRevision[]
  payrollBatches            PayrollBatch[]
  payrollRuns               PayrollRun[]
  payrollRunEmployees       PayrollRunEmployee[]
  payrollItems              PayrollItem[]
  payrollAdjustments        PayrollAdjustment[]
  payrollPayments           PayrollPayment[]
  payslips                  Payslip[]
  form16Records             Form16Record[]
  loans                     Loan[]
  loanInstallments          LoanInstallment[]
  reimbursementClaims       ReimbursementClaim[]
  // AI
  aiSettings                AiSetting[]
  aiConversations           AiConversation[]
  aiMessages                AiMessage[]
  aiUsageLogs               AiUsageLog[]

  // Assets
  assetCategories           AssetCategory[]
  assets                    Asset[]
  assetAssignments          AssetAssignment[]
  assetTransfers            AssetTransfer[]
  assetMaintenance          AssetMaintenance[]
  assetDisposals            AssetDisposal[]
  assetAudits               AssetAudit[]
  assetAuditItems           AssetAuditItem[]
  inventoryItems            InventoryItem[]
  inventoryTransactions     InventoryTransaction[]
  libraryBooks              LibraryBook[]
  libraryCopies             LibraryCopy[]
  libraryPolicies           LibraryPolicy[]
  libraryLoans              LibraryLoan[]
  libraryReservations       LibraryReservation[]
  libraryFines              LibraryFine[]
  libraryStockVerifications LibraryStockVerification[]
  // Fees & Finance
  feeHeads                  FeeHead[]
  feeLateRules              FeeLateRule[]
  feeStructures             FeeStructure[]
  feeInstallments           FeeInstallment[]
  feeStructureItems         FeeStructureItem[]
  feeConcessions            FeeConcession[]
  feeInvoices               FeeInvoice[]
  feeInvoiceLines           FeeInvoiceLine[]
  feePayments               FeePayment[]
  feePaymentAllocations     FeePaymentAllocation[]
  feeRefunds                FeeRefund[]
  financeNumberSeries       FinanceNumberSeries[]
  paymentGatewayOrders      PaymentGatewayOrder[]
  ledgerAccounts            LedgerAccount[]
  journalVouchers           JournalVoucher[]
  journalLines              JournalLine[]
  vendors                   Vendor[]
  expenses                  Expense[]
  transportVehicles         TransportVehicle[]
  transportStaff            TransportStaff[]
  transportRoutes           TransportRoute[]
  transportStops            TransportStop[]
  transportFareSlabs        TransportFareSlab[]
  transportAllocations      TransportAllocation[]
  transportCharges          TransportCharge[]
  transportTrips            TransportTrip[]
  transportBoardings        TransportBoarding[]
  transportIncidents        TransportIncident[]
  transportFuelLogs         TransportFuelLog[]
  transportMaintenanceLogs  TransportMaintenanceLog[]
  hostels                   Hostel[]
  hostelBlocks              HostelBlock[]
  hostelRooms               HostelRoom[]
  hostelBeds                HostelBed[]
  hostelMessPlans           HostelMessPlan[]
  hostelAllocations         HostelAllocation[]
  hostelCharges             HostelCharge[]
  hostelVisitors            HostelVisitor[]
  hostelOutpasses           HostelOutpass[]
  hostelMovements           HostelMovement[]
  hostelComplaints          HostelComplaint[]
  hostelRollCalls           HostelRollCall[]
  hostelRollCallEntries     HostelRollCallEntry[]

  @@map("organizations")
}

/// Education group (e.g. "ABBS Group") owning multiple institutions.
model Group {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  description    String?      @db.VarChar(1000)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institutions     Institution[]
  userScopes       UserScope[]
  featureOverrides FeatureOverride[]
  brandingProfiles BrandingProfile[]
  secrets          TenantSecret[]
  documents        Document[]
  students         Student[]
  guardians        Guardian[]
  studentGuardians StudentGuardian[]
  admissions       AdmissionApplication[]

  employees     Employee[]
  leavePolicies LeavePolicy[]

  assetCategories AssetCategory[]
  assets          Asset[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("groups")
}

/// School / college / university. `groupId` is null for independent institutions.
model Institution {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  groupId        String?         @map("group_id") @db.Char(36)
  name           String          @db.VarChar(200)
  code           String          @db.VarChar(32)
  type           InstitutionType @default(COLLEGE)
  status         EntityStatus    @default(ACTIVE)
  email          String?         @db.VarChar(200)
  phone          String?         @db.VarChar(32)
  address        String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?       @map("deleted_at") @db.DateTime(3)

  // Academics & Exams
  subjects      Subject[]
  bellPeriods   BellPeriod[]
  gradingScales GradingScale[]
  examTerms     ExamTerm[]

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group                Group?                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  campuses             Campus[]
  departments          Department[]
  programs             Program[]
  classSections        ClassSection[]
  userScopes           UserScope[]
  featureOverrides     FeatureOverride[]
  brandingProfiles     BrandingProfile[]
  secrets              TenantSecret[]
  documents            Document[]
  studentCodeSequences StudentCodeSequence[]
  students             Student[]
  studentEnrollments   StudentEnrollment[]
  guardians            Guardian[]
  studentGuardians     StudentGuardian[]
  admissions           AdmissionApplication[]

  employees          Employee[]
  holidayCalendars   HolidayCalendar[]
  shifts             Shift[]
  attendanceLocks    AttendancePeriodLock[]
  attendancePolicies AttendancePolicy[]
  leavePolicies      LeavePolicy[]

  assetCategories           AssetCategory[]
  assets                    Asset[]
  assetAudits               AssetAudit[]
  inventoryItems            InventoryItem[]
  libraryBooks              LibraryBook[]
  libraryCopies             LibraryCopy[]
  libraryPolicies           LibraryPolicy[]
  libraryLoans              LibraryLoan[]
  libraryReservations       LibraryReservation[]
  libraryFines              LibraryFine[]
  libraryStockVerifications LibraryStockVerification[]

  @@unique([organizationId, code])
  @@index([organizationId, groupId])
  @@index([organizationId, deletedAt])
  @@index([groupId])
  @@map("institutions")
}

model Campus {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  address        String?      @db.VarChar(500)
  isMain         Boolean      @default(false) @map("is_main")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  departments        Department[]
  classSections      ClassSection[]
  userScopes         UserScope[]
  documents          Document[]
  students           Student[]
  studentEnrollments StudentEnrollment[]

  employees Employee[]

  assets Asset[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, deletedAt])
  @@map("campuses")
}

model Department {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  campusId       String?      @map("campus_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  description    String?      @db.VarChar(1000)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution        Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus             Campus?                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  programs           Program[]
  classSections      ClassSection[]
  userScopes         UserScope[]
  documents          Document[]
  students           Student[]
  studentEnrollments StudentEnrollment[]
  admissions         AdmissionApplication[]

  employees    Employee[]
  designations Designation[]

  assets Asset[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, campusId])
  @@index([organizationId, deletedAt])
  @@map("departments")
}

/// Program / course offered by a department (e.g. B.Sc Computer Science, Grade 10).
model Program {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  departmentId   String       @map("department_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  level          ProgramLevel @default(UNDERGRADUATE)
  durationMonths Int?         @map("duration_months")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  subjects Subject[]

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution        Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  classSections      ClassSection[]
  students           Student[]
  studentEnrollments StudentEnrollment[]
  admissions         AdmissionApplication[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@index([organizationId, deletedAt])
  @@map("programs")
}

/// Class / section / batch within a program (e.g. "BSc CS 2025 - Section A").
model ClassSection {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  departmentId   String       @map("department_id") @db.Char(36)
  programId      String       @map("program_id") @db.Char(36)
  campusId       String?      @map("campus_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  academicYear   String?      @map("academic_year") @db.VarChar(9)
  capacity       Int?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  // Academics & Exams
  subjectAllocations SubjectAllocation[]
  classTeacher       ClassTeacherAssignment[]
  timetableEntries   TimetableEntry[]
  studentAttendance  StudentAttendance[]
  examSchedules      ExamSchedule[]
  examResults        ExamResult[]

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department   Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program      Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  campus       Campus?                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  students     Student[]
  enrollments  StudentEnrollment[]
  admissions   AdmissionApplication[]

  @@unique([programId, code, academicYear])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@index([organizationId, programId])
  @@index([organizationId, campusId])
  @@index([organizationId, deletedAt])
  @@map("class_sections")
}

// ---------------------------------------------------------------------------
// Student information system — students, guardians and admissions
// ---------------------------------------------------------------------------

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
  ALUMNI
}

enum StudentEnrollmentStatus {
  ENROLLED
  PROMOTED
  DETAINED
  WITHDRAWN
  GRADUATED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
  ENROLLED
}

model StudentCodeSequence {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  academicYear   String   @map("academic_year") @db.VarChar(9)
  prefix         String   @db.VarChar(40)
  padding        Int      @default(4)
  nextNumber     Int      @default(1) @map("next_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, institutionId, academicYear])
  @@index([organizationId, institutionId])
  @@map("student_code_sequences")
}

model Student {
  id              String        @id @default(uuid()) @db.Char(36)
  organizationId  String        @map("organization_id") @db.Char(36)
  admissionNo     String        @map("admission_no") @db.VarChar(40)
  rollNo          String?       @map("roll_no") @db.VarChar(40)
  userId          String?       @map("user_id") @db.Char(36)
  groupId         String?       @map("group_id") @db.Char(36)
  institutionId   String        @map("institution_id") @db.Char(36)
  campusId        String?       @map("campus_id") @db.Char(36)
  departmentId    String        @map("department_id") @db.Char(36)
  programId       String        @map("program_id") @db.Char(36)
  classSectionId  String        @map("class_section_id") @db.Char(36)
  academicYear    String        @map("academic_year") @db.VarChar(9)
  status          StudentStatus @default(ACTIVE)
  firstName       String        @map("first_name") @db.VarChar(100)
  middleName      String?       @map("middle_name") @db.VarChar(100)
  lastName        String?       @map("last_name") @db.VarChar(100)
  displayName     String        @map("display_name") @db.VarChar(200)
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  gender          String?       @db.VarChar(24)
  bloodGroup      String?       @map("blood_group") @db.VarChar(8)
  email           String?       @db.VarChar(254)
  phone           String?       @db.VarChar(32)
  address         Json?
  photoDocumentId String?       @map("photo_document_id") @db.Char(36)
  admissionDate   DateTime?     @map("admission_date") @db.Date
  category        String?       @db.VarChar(64)
  quota           String?       @db.VarChar(64)
  previousSchool  String?       @map("previous_school") @db.VarChar(200)
  notes           String?       @db.VarChar(2000)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime?     @map("deleted_at") @db.DateTime(3)

  // Academics & Exams
  attendance  StudentAttendance[]
  examMarks   ExamMark[]
  examResults ExamResult[]

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  group        Group?                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution            @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus       Campus?                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  department   Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program      Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  classSection ClassSection           @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  enrollments  StudentEnrollment[]
  guardians    StudentGuardian[]
  admissions   AdmissionApplication[]

  @@unique([organizationId, admissionNo])
  @@unique([organizationId, userId])
  @@unique([organizationId, classSectionId, rollNo])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, groupId])
  @@index([organizationId, departmentId])
  @@index([organizationId, programId])
  @@index([organizationId, classSectionId])
  @@index([organizationId, deletedAt])
  @@map("students")
}

model StudentEnrollment {
  id             String                  @id @default(uuid()) @db.Char(36)
  organizationId String                  @map("organization_id") @db.Char(36)
  studentId      String                  @map("student_id") @db.Char(36)
  groupId        String?                 @map("group_id") @db.Char(36)
  institutionId  String                  @map("institution_id") @db.Char(36)
  campusId       String?                 @map("campus_id") @db.Char(36)
  departmentId   String                  @map("department_id") @db.Char(36)
  programId      String                  @map("program_id") @db.Char(36)
  classSectionId String                  @map("class_section_id") @db.Char(36)
  academicYear   String                  @map("academic_year") @db.VarChar(9)
  rollNo         String?                 @map("roll_no") @db.VarChar(40)
  fromDate       DateTime                @map("from_date") @db.Date
  toDate         DateTime?               @map("to_date") @db.Date
  status         StudentEnrollmentStatus @default(ENROLLED)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)

  @@index([organizationId, studentId])
  @@index([organizationId, institutionId, academicYear])
  @@index([organizationId, classSectionId, status])
  @@map("student_enrollments")
}

model Guardian {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String?   @map("user_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  name           String    @db.VarChar(200)
  phone          String?   @db.VarChar(32)
  email          String?   @db.VarChar(254)
  occupation     String?   @db.VarChar(120)
  address        Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  group        Group?            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  students     StudentGuardian[]

  @@unique([organizationId, userId])
  @@index([organizationId, institutionId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, deletedAt])
  @@map("guardians")
}

model StudentGuardian {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  studentId      String           @map("student_id") @db.Char(36)
  guardianId     String           @map("guardian_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String           @map("institution_id") @db.Char(36)
  relation       GuardianRelation
  isPrimary      Boolean          @default(false) @map("is_primary")
  canPickup      Boolean          @default(true) @map("can_pickup")
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?        @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian     Guardian     @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, studentId, guardianId])
  @@index([organizationId, guardianId])
  @@index([organizationId, institutionId])
  @@index([organizationId, deletedAt])
  @@map("student_guardians")
}

model AdmissionApplication {
  id                   String           @id @default(uuid()) @db.Char(36)
  organizationId       String           @map("organization_id") @db.Char(36)
  applicationNo        String           @map("application_no") @db.VarChar(40)
  groupId              String?          @map("group_id") @db.Char(36)
  institutionId        String           @map("institution_id") @db.Char(36)
  departmentId         String           @map("department_id") @db.Char(36)
  programId            String           @map("program_id") @db.Char(36)
  classSectionId       String?          @map("class_section_id") @db.Char(36)
  academicYear         String           @map("academic_year") @db.VarChar(9)
  status               AdmissionStatus  @default(SUBMITTED)
  applicantFirstName   String           @map("applicant_first_name") @db.VarChar(100)
  applicantMiddleName  String?          @map("applicant_middle_name") @db.VarChar(100)
  applicantLastName    String?          @map("applicant_last_name") @db.VarChar(100)
  applicantDisplayName String           @map("applicant_display_name") @db.VarChar(200)
  dateOfBirth          DateTime?        @map("date_of_birth") @db.Date
  gender               String?          @db.VarChar(24)
  email                String?          @db.VarChar(254)
  phone                String?          @db.VarChar(32)
  previousSchool       String?          @map("previous_school") @db.VarChar(200)
  marksPercent         Decimal?         @map("marks_percent") @db.Decimal(5, 2)
  guardianName         String           @map("guardian_name") @db.VarChar(200)
  guardianRelation     GuardianRelation @map("guardian_relation")
  guardianPhone        String?          @map("guardian_phone") @db.VarChar(32)
  guardianEmail        String?          @map("guardian_email") @db.VarChar(254)
  decisionComment      String?          @map("decision_comment") @db.VarChar(1000)
  studentId            String?          @map("student_id") @db.Char(36)
  submittedAt          DateTime?        @map("submitted_at") @db.DateTime(3)
  decidedAt            DateTime?        @map("decided_at") @db.DateTime(3)
  enrolledAt           DateTime?        @map("enrolled_at") @db.DateTime(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt            DateTime?        @map("deleted_at") @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program      Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  classSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, applicationNo])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, programId])
  @@index([organizationId, classSectionId])
  @@index([organizationId, deletedAt])
  @@map("admission_applications")
}

// ---------------------------------------------------------------------------
// Layer 2 — Identity, authentication, authorization (RBAC + scopes) and audit
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Breadth of a role assignment. PLATFORM roles are not stored here (see PlatformRoleAssignment).
enum ScopeType {
  ORGANIZATION
  GROUP
  INSTITUTION
  CAMPUS
  DEPARTMENT
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
}

/// Platform-level identity (GLOBAL). A user joins tenants through OrganizationMembership.
/// Only core/auth touches this table; modules use the identity service.
model User {
  id                  String     @id @default(uuid()) @db.Char(36)
  email               String     @unique @db.VarChar(254)
  name                String     @db.VarChar(200)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  status              UserStatus @default(ACTIVE)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  /// TOTP secret, AES-256-GCM encrypted (core/crypto). Never returned by the API.
  mfaSecretEnc        String?    @map("mfa_secret_enc") @db.VarChar(512)
  mfaPendingSecretEnc String?    @map("mfa_pending_secret_enc") @db.VarChar(512)
  /// Last accepted TOTP time-step (replay protection).
  mfaLastUsedStep     Int?       @map("mfa_last_used_step")
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until") @db.DateTime(3)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.DateTime(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime?  @map("deleted_at") @db.DateTime(3)

  // Academics & Exams
  subjectAllocations     SubjectAllocation[]      @relation("SubjectAllocationTeacher")
  classTeacherOf         ClassTeacherAssignment[] @relation("ClassTeacherUser")
  timetableEntries       TimetableEntry[]         @relation("TimetableTeacher")
  timetableSubstitutions TimetableSubstitution[]  @relation("TimetableSubstitute")

  memberships   OrganizationMembership[]
  platformRoles PlatformRoleAssignment[]
  userRoles     UserRole[]
  userScopes    UserScope[]
  sessions      AuthSession[]
  loginEvents   LoginEvent[]
  recoveryCodes MfaRecoveryCode[]
  tokens        UserToken[]
  auditLogs     AuditLog[]

  employees Employee[]
  students  Student[]
  guardians Guardian[]

  @@map("users")
}

/// Platform roles (platform_super_admin, platform_support_admin). Permissions come from the
/// code catalog (core/authz/default-roles.ts). GLOBAL; managed by core only.
model PlatformRoleAssignment {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleKey   String   @map("role_key") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, roleKey])
  @@map("platform_role_assignments")
}

/// A user's membership of a tenant.
model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  userId         String           @map("user_id") @db.Char(36)
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?        @map("joined_at") @db.DateTime(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?        @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_memberships")
}

/// Permission catalog (GLOBAL), synced from @erp/shared PERMISSIONS.
model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(64)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Tenant role. System roles (isSystem) are provisioned per organization from the defaults.
model Role {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  key            String    @db.VarChar(64)
  name           String    @db.VarChar(200)
  description    String?   @db.VarChar(1000)
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, key])
  @@index([organizationId, deletedAt])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  roleId         String   @map("role_id") @db.Char(36)
  permissionId   String   @map("permission_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([organizationId, roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Assignment of a role to a user. Effective only within the assignment's UserScopes.
model UserRole {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  roleId         String   @map("role_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopes       UserScope[]

  @@unique([organizationId, userId, roleId])
  @@index([organizationId, userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Where a role assignment applies. `scopeType` decides which FK is the scope target; the other
/// hierarchy FKs are denormalized ancestors (e.g. a DEPARTMENT scope also stores its institution
/// and group) so "users within my scope" filters stay simple.
model UserScope {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  userRoleId     String    @map("user_role_id") @db.Char(36)
  scopeType      ScopeType @map("scope_type")
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String?   @map("institution_id") @db.Char(36)
  campusId       String?   @map("campus_id") @db.Char(36)
  departmentId   String?   @map("department_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  userRole     UserRole     @relation(fields: [userRoleId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId])
  @@index([organizationId, userRoleId])
  @@index([organizationId, institutionId])
  @@index([organizationId, groupId])
  @@map("user_scopes")
}

/// Device/login session (CORE-MANAGED). organizationId is the tenant the session is bound to;
/// null for platform-only sessions.
model AuthSession {
  id                   String    @id @default(uuid()) @db.Char(36)
  userId               String    @map("user_id") @db.Char(36)
  organizationId       String?   @map("organization_id") @db.Char(36)
  ip                   String?   @db.VarChar(64)
  userAgent            String?   @map("user_agent") @db.VarChar(512)
  deviceName           String?   @map("device_name") @db.VarChar(100)
  mfaVerified          Boolean   @default(false) @map("mfa_verified")
  /// Set for audited platform cross-tenant access sessions.
  platformAccessReason String?   @map("platform_access_reason") @db.VarChar(500)
  expiresAt            DateTime  @map("expires_at") @db.DateTime(3)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.DateTime(3)
  revokedAt            DateTime? @map("revoked_at") @db.DateTime(3)
  revokedReason        String?   @map("revoked_reason") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([organizationId, userId])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Rotating refresh tokens; only a SHA-256 hash is stored. GLOBAL (child of AuthSession).
model RefreshToken {
  id        String             @id @default(uuid()) @db.Char(36)
  sessionId String             @map("session_id") @db.Char(36)
  tokenHash String             @unique @map("token_hash") @db.Char(64)
  status    RefreshTokenStatus @default(ACTIVE)
  expiresAt DateTime           @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?          @map("used_at") @db.DateTime(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, status])
  @@map("refresh_tokens")
}

/// Login history (CORE-MANAGED). Append-only.
model LoginEvent {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String?  @map("organization_id") @db.Char(36)
  userId         String?  @map("user_id") @db.Char(36)
  email          String   @db.VarChar(254)
  success        Boolean
  failureReason  String?  @map("failure_reason") @db.VarChar(64)
  mfaUsed        Boolean  @default(false) @map("mfa_used")
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("login_events")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// One-time invite / password-reset tokens (CORE-MANAGED); only a SHA-256 hash is stored.
model UserToken {
  id             String        @id @default(uuid()) @db.Char(36)
  userId         String        @map("user_id") @db.Char(36)
  organizationId String?       @map("organization_id") @db.Char(36)
  type           UserTokenType
  tokenHash      String        @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime      @map("expires_at") @db.DateTime(3)
  usedAt         DateTime?     @map("used_at") @db.DateTime(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, type])
  @@index([organizationId, type])
  @@map("user_tokens")
}

/// Audit trail (CORE-MANAGED, APPEND-ONLY: database triggers reject UPDATE and DELETE).
/// organizationId is null only for platform-level events.
model AuditLog {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String?  @map("organization_id") @db.Char(36)
  actorUserId    String?  @map("actor_user_id") @db.Char(36)
  /// user | platform | system | dev
  actorType      String   @map("actor_type") @db.VarChar(16)
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  before         Json?
  after          Json?
  reason         String?  @db.VarChar(500)
  metadata       Json?
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId, createdAt])
  @@index([organizationId, action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// Subscription / module licensing (spec §63, §64), branding (§65.5), secrets (§44, §62)
// ---------------------------------------------------------------------------------------------

/// Hierarchy level a setting (feature override, branding, secret) is attached to.
enum SettingScopeType {
  ORGANIZATION
  GROUP
  INSTITUTION
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  /// The organization reported a UPI payment (UTR); awaiting platform verification.
  PAYMENT_SUBMITTED
  PAID
  OVERDUE
  VOID
}

/// Platform-managed plan catalog (GLOBAL — not tenant data).
model SubscriptionPlan {
  id              String          @id @default(uuid()) @db.Char(36)
  key             String          @unique @db.VarChar(64)
  name            String          @db.VarChar(200)
  description     String?         @db.VarChar(1000)
  status          PlanStatus      @default(ACTIVE)
  priceCents      Int             @default(0) @map("price_cents")
  currency        String          @default("INR") @db.Char(3)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  trialDays       Int             @default(14) @map("trial_days")
  /// FeatureKey[]
  features        Json
  /// PlanLimits — `null` value = unlimited, missing key = 0.
  limits          Json
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  subscriptions OrganizationSubscription[]

  @@map("subscription_plans")
}

/// One subscription per organization.
model OrganizationSubscription {
  id                 String             @id @default(uuid()) @db.Char(36)
  organizationId     String             @unique @map("organization_id") @db.Char(36)
  planId             String             @map("plan_id") @db.Char(36)
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.DateTime(3)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.DateTime(3)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.DateTime(3)
  cancelledAt        DateTime?          @map("cancelled_at") @db.DateTime(3)
  /// FeatureKey[] licensed on top of the plan.
  addOnFeatures      Json               @map("add_on_features")
  /// PlanLimits merged over the plan limits.
  limitOverrides     Json               @map("limit_overrides")
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([planId])
  @@map("organization_subscriptions")
}

/// Subscription invoice. No payment gateway yet — `status` doubles as the payment status.
model Invoice {
  id                 String        @id @default(uuid()) @db.Char(36)
  organizationId     String        @map("organization_id") @db.Char(36)
  subscriptionId     String        @map("subscription_id") @db.Char(36)
  number             String        @unique @db.VarChar(40)
  periodStart        DateTime      @map("period_start") @db.DateTime(3)
  periodEnd          DateTime      @map("period_end") @db.DateTime(3)
  amountCents        Int           @map("amount_cents")
  currency           String        @db.Char(3)
  status             InvoiceStatus @default(OPEN)
  issuedAt           DateTime?     @map("issued_at") @db.DateTime(3)
  dueAt              DateTime      @map("due_at") @db.DateTime(3)
  paidAt             DateTime?     @map("paid_at") @db.DateTime(3)
  paymentMethod      String?       @map("payment_method") @db.VarChar(64)
  paymentReference   String?       @map("payment_reference") @db.VarChar(128)
  notes              String?       @db.VarChar(1000)
  /// InvoiceLineItem[] — `{description, quantity, unitCents}`; null for legacy single-amount invoices.
  lineItems          Json?         @map("line_items")
  subtotalCents      Int           @default(0) @map("subtotal_cents")
  /// Tax rate in basis points (1800 = 18% GST).
  taxRateBps         Int           @default(0) @map("tax_rate_bps")
  taxCents           Int           @default(0) @map("tax_cents")
  /// Payment reported by the organization (UPI UTR), pending platform verification.
  submittedReference String?       @map("submitted_reference") @db.VarChar(128)
  submittedNote      String?       @map("submitted_note") @db.VarChar(500)
  submittedAt        DateTime?     @map("submitted_at") @db.DateTime(3)
  submittedByUserId  String?       @map("submitted_by_user_id") @db.Char(36)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([subscriptionId])
  @@map("invoices")
}

/// Platform seller details printed on invoices and the UPI payee (single row, id = "default").
model PlatformBillingSettings {
  id                String   @id @db.VarChar(36)
  sellerName        String   @map("seller_name") @db.VarChar(200)
  sellerAddress     String?  @map("seller_address") @db.VarChar(1000)
  gstin             String?  @db.VarChar(20)
  contactEmail      String?  @map("contact_email") @db.VarChar(254)
  contactPhone      String?  @map("contact_phone") @db.VarChar(40)
  upiId             String?  @map("upi_id") @db.VarChar(100)
  upiPayeeName      String?  @map("upi_payee_name") @db.VarChar(100)
  defaultTaxRateBps Int      @default(1800) @map("default_tax_rate_bps")
  invoiceTerms      String?  @map("invoice_terms") @db.VarChar(1000)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("platform_billing_settings")
}

/// Enable/disable a licensed module at org / group / institution level. Can never exceed the
/// license (enforced in core/features).
model FeatureOverride {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  scopeType      SettingScopeType @map("scope_type")
  /// organizationId / groupId / institutionId according to scopeType.
  targetId       String           @map("target_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String?          @map("institution_id") @db.Char(36)
  featureKey     String           @map("feature_key") @db.VarChar(64)
  enabled        Boolean
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeType, targetId, featureKey])
  @@index([groupId])
  @@index([institutionId])
  @@map("feature_overrides")
}

/// Usage counter for plan limits. periodKey = 'total' (gauges) or 'YYYY-MM' UTC (monthly).
model UsageCounter {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  limitKey       String   @map("limit_key") @db.VarChar(64)
  periodKey      String   @map("period_key") @db.VarChar(16)
  used           BigInt   @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, limitKey, periodKey])
  @@map("usage_counters")
}

/// Branding per org / group / institution; null fields inherit from the parent level.
model BrandingProfile {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  scopeType      SettingScopeType @map("scope_type")
  targetId       String           @map("target_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String?          @map("institution_id") @db.Char(36)
  displayName    String?          @map("display_name") @db.VarChar(200)
  shortName      String?          @map("short_name") @db.VarChar(50)
  /// Storage key of the logo's current version (kept in sync by the logo upload endpoint).
  logoStorageKey String?          @map("logo_storage_key") @db.VarChar(512)
  /// Logo document (module `branding`, category `branding`).
  logoFileId     String?          @map("logo_file_id") @db.Char(36)
  primaryColor   String?          @map("primary_color") @db.Char(7)
  secondaryColor String?          @map("secondary_color") @db.Char(7)
  accentColor    String?          @map("accent_color") @db.Char(7)
  letterheadText String?          @map("letterhead_text") @db.Text
  footerText     String?          @map("footer_text") @db.VarChar(1000)
  address        String?          @db.VarChar(500)
  contactEmail   String?          @map("contact_email") @db.VarChar(200)
  contactPhone   String?          @map("contact_phone") @db.VarChar(32)
  website        String?          @db.VarChar(300)
  customDomain   String?          @unique @map("custom_domain") @db.VarChar(253)
  subdomain      String?          @unique @db.VarChar(63)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  logoFile     Document?    @relation(fields: [logoFileId], references: [id], onDelete: SetNull)

  @@unique([organizationId, scopeType, targetId])
  @@index([logoFileId])
  @@index([groupId])
  @@index([institutionId])
  @@map("branding_profiles")
}

/// Envelope-encrypted tenant secret. Hard-deleted (crypto-shredded) — never soft-deleted.
model TenantSecret {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  scopeType      SettingScopeType @map("scope_type")
  targetId       String           @map("target_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String?          @map("institution_id") @db.Char(36)
  kind           String           @db.VarChar(64)
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(500)
  /// Non-secret configuration (host, sender id, model…).
  metadata       Json?
  /// AES-256-GCM ciphertext of the value under a per-secret data key.
  ciphertext     String           @db.Text
  /// Data key wrapped by the master key (KeyProvider).
  wrappedKey     String           @map("wrapped_key") @db.VarChar(512)
  keyProvider    String           @map("key_provider") @db.VarChar(32)
  keyVersion     Int              @map("key_version")
  last4          String?          @db.VarChar(4)
  fingerprint    String           @db.VarChar(64)
  version        Int              @default(1)
  createdById    String?          @map("created_by_id") @db.Char(36)
  updatedById    String?          @map("updated_by_id") @db.Char(36)
  rotatedAt      DateTime?        @map("rotated_at") @db.DateTime(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeType, targetId, kind, name])
  @@index([organizationId, kind])
  @@index([groupId])
  @@index([institutionId])
  @@index([keyVersion])
  @@map("tenant_secrets")
}

// ---------------------------------------------------------------------------------------------
// File storage & document engine (Layer 4, core/storage + core/documents). Files live in
// private object storage; these tables hold metadata only (never BLOBs).
// ---------------------------------------------------------------------------------------------

enum DocumentConfidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

enum DocumentGranteeType {
  USER
  ROLE
  SCOPE
}

enum DocumentReminderStatus {
  PENDING
  SENT
  CANCELLED
}

enum DocumentSignatureStatus {
  PENDING
  SENT
  SIGNED
  DECLINED
  CANCELLED
}

enum StorageUploadStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

/// A document attached to an owner entity (`ownerType` / `ownerId`, e.g. employee / institution).
/// Hierarchy FKs are derived from the owner (never client supplied) and drive scope checks.
model Document {
  id               String                  @id @default(uuid()) @db.Char(36)
  organizationId   String                  @map("organization_id") @db.Char(36)
  groupId          String?                 @map("group_id") @db.Char(36)
  institutionId    String?                 @map("institution_id") @db.Char(36)
  campusId         String?                 @map("campus_id") @db.Char(36)
  departmentId     String?                 @map("department_id") @db.Char(36)
  ownerType        String                  @map("owner_type") @db.VarChar(50)
  ownerId          String                  @map("owner_id") @db.Char(36)
  /// Module that attached the document (documents, branding, pdf, hr, payroll…).
  module           String                  @default("documents") @db.VarChar(50)
  category         String                  @db.VarChar(50)
  documentType     String?                 @map("document_type") @db.VarChar(64)
  title            String                  @db.VarChar(255)
  description      String?                 @db.VarChar(2000)
  confidentiality  DocumentConfidentiality @default(INTERNAL)
  status           DocumentStatus          @default(ACTIVE)
  currentVersionId String?                 @unique @map("current_version_id") @db.Char(36)
  issueDate        DateTime?               @map("issue_date") @db.Date
  expiryDate       DateTime?               @map("expiry_date") @db.Date
  /// Non-sensitive module metadata (e.g. PDF template key/version).
  metadata         Json?
  createdById      String?                 @map("created_by_id") @db.Char(36)
  updatedById      String?                 @map("updated_by_id") @db.Char(36)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime?               @map("deleted_at") @db.DateTime(3)
  deletedById      String?                 @map("deleted_by_id") @db.Char(36)
  /// Soft-deleted documents' objects are purged after this date (retention).
  purgeAfter       DateTime?               @map("purge_after") @db.DateTime(3)
  purgedAt         DateTime?               @map("purged_at") @db.DateTime(3)

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group            Group?                   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution      Institution?             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus           Campus?                  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  department       Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  currentVersion   DocumentVersion?         @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[]        @relation("DocumentVersions")
  permissions      DocumentPermission[]
  reminders        DocumentExpiryReminder[]
  signatures       DocumentSignature[]
  brandingProfiles BrandingProfile[]

  @@index([organizationId, ownerType, ownerId])
  @@index([organizationId, institutionId, category])
  @@index([organizationId, groupId])
  @@index([organizationId, expiryDate])
  @@index([organizationId, deletedAt, purgeAfter])
  @@map("documents")
}

/// Immutable file version (DB triggers reject content updates and deletes; only scan status /
/// purge bookkeeping may change). Restoring creates a NEW version copying an older object.
model DocumentVersion {
  id                    String             @id @default(uuid()) @db.Char(36)
  organizationId        String             @map("organization_id") @db.Char(36)
  documentId            String             @map("document_id") @db.Char(36)
  versionNumber         Int                @map("version_number")
  /// Server-generated tenant-prefixed object key (see core/storage/keys.ts).
  storageKey            String             @unique @map("storage_key") @db.VarChar(512)
  /// `platform` or `tenant` (per-organization storage secret, see storageSecretId).
  storageBackend        String             @default("platform") @map("storage_backend") @db.VarChar(16)
  storageSecretId       String?            @map("storage_secret_id") @db.Char(36)
  /// Object version id when the bucket is versioned (S3).
  storageVersionId      String?            @map("storage_version_id") @db.VarChar(1024)
  fileName              String             @map("file_name") @db.VarChar(255)
  mimeType              String             @map("mime_type") @db.VarChar(127)
  sizeBytes             Int                @map("size_bytes")
  checksumSha256        String             @map("checksum_sha256") @db.Char(64)
  scanStatus            DocumentScanStatus @default(PENDING) @map("scan_status")
  scannedAt             DateTime?          @map("scanned_at") @db.DateTime(3)
  reason                String?            @db.VarChar(500)
  uploadedById          String?            @map("uploaded_by_id") @db.Char(36)
  previousVersionId     String?            @map("previous_version_id") @db.Char(36)
  restoredFromVersionId String?            @map("restored_from_version_id") @db.Char(36)
  purgedAt              DateTime?          @map("purged_at") @db.DateTime(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document            @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  currentOf    Document?           @relation("DocumentCurrentVersion")
  signatures   DocumentSignature[]

  @@unique([documentId, versionNumber])
  @@index([organizationId, documentId])
  @@map("document_versions")
}

/// Explicit per-document grant to a user, a role (by key) or a hierarchy scope.
model DocumentPermission {
  id               String              @id @default(uuid()) @db.Char(36)
  organizationId   String              @map("organization_id") @db.Char(36)
  documentId       String              @map("document_id") @db.Char(36)
  granteeType      DocumentGranteeType @map("grantee_type")
  userId           String?             @map("user_id") @db.Char(36)
  roleKey          String?             @map("role_key") @db.VarChar(64)
  scopeType        ScopeType?          @map("scope_type")
  scopeId          String?             @map("scope_id") @db.Char(36)
  canView          Boolean             @default(true) @map("can_view")
  canDownload      Boolean             @default(false) @map("can_download")
  canUploadVersion Boolean             @default(false) @map("can_upload_version")
  canDelete        Boolean             @default(false) @map("can_delete")
  canShare         Boolean             @default(false) @map("can_share")
  expiresAt        DateTime?           @map("expires_at") @db.DateTime(3)
  createdById      String?             @map("created_by_id") @db.Char(36)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
  @@index([organizationId, userId])
  @@index([organizationId, roleKey])
  @@map("document_permissions")
}

/// Expiry reminder schedule (spec §34). Sending is done by the notification engine (Layer 5)
/// through `dueExpiryReminders()` / `markReminderSent()`.
model DocumentExpiryReminder {
  id             String                 @id @default(uuid()) @db.Char(36)
  organizationId String                 @map("organization_id") @db.Char(36)
  documentId     String                 @map("document_id") @db.Char(36)
  daysBefore     Int                    @map("days_before")
  remindAt       DateTime               @map("remind_at") @db.Date
  status         DocumentReminderStatus @default(PENDING)
  sentAt         DateTime?              @map("sent_at") @db.DateTime(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, daysBefore])
  @@index([organizationId, status, remindAt])
  @@map("document_expiry_reminders")
}

/// E-signature request placeholder (spec §37): status tracking only, no provider integration.
model DocumentSignature {
  id             String                  @id @default(uuid()) @db.Char(36)
  organizationId String                  @map("organization_id") @db.Char(36)
  documentId     String                  @map("document_id") @db.Char(36)
  versionId      String                  @map("version_id") @db.Char(36)
  signerUserId   String?                 @map("signer_user_id") @db.Char(36)
  signerName     String                  @map("signer_name") @db.VarChar(200)
  signerEmail    String?                 @map("signer_email") @db.VarChar(200)
  signerRole     String?                 @map("signer_role") @db.VarChar(100)
  signingOrder   Int                     @default(1) @map("signing_order")
  status         DocumentSignatureStatus @default(PENDING)
  note           String?                 @db.VarChar(500)
  /// Future: external provider + envelope id.
  provider       String?                 @db.VarChar(50)
  providerRef    String?                 @map("provider_ref") @db.VarChar(255)
  respondedAt    DateTime?               @map("responded_at") @db.DateTime(3)
  createdById    String?                 @map("created_by_id") @db.Char(36)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([organizationId, documentId])
  @@index([organizationId, signerUserId, status])
  @@map("document_signatures")
}

/// Pending signed-URL upload session. The object key is server generated; finalize verifies
/// the stored object (size / checksum) before a document version is recorded.
model StorageUpload {
  id                String              @id @default(uuid()) @db.Char(36)
  organizationId    String              @map("organization_id") @db.Char(36)
  /// `document.create` or `document.version`.
  purpose           String              @db.VarChar(32)
  documentId        String?             @map("document_id") @db.Char(36)
  storageKey        String              @unique @map("storage_key") @db.VarChar(512)
  storageBackend    String              @default("platform") @map("storage_backend") @db.VarChar(16)
  storageSecretId   String?             @map("storage_secret_id") @db.Char(36)
  fileName          String              @map("file_name") @db.VarChar(255)
  mimeType          String              @map("mime_type") @db.VarChar(127)
  declaredSizeBytes Int                 @map("declared_size_bytes")
  declaredChecksum  String?             @map("declared_checksum") @db.Char(64)
  /// Validated document metadata / version reason to apply on finalize.
  payload           Json
  status            StorageUploadStatus @default(PENDING)
  expiresAt         DateTime            @map("expires_at") @db.DateTime(3)
  completedAt       DateTime?           @map("completed_at") @db.DateTime(3)
  createdById       String?             @map("created_by_id") @db.Char(36)
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@map("storage_uploads")
}

// ---------------------------------------------------------------------------------------------
// Workflow engine (Layer 5, core/workflow). Tenant-scoped, versioned approval workflows.
// ---------------------------------------------------------------------------------------------

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  SENT_BACK
  CANCELLED
}

enum WorkflowStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  SENT_BACK
  CANCELLED
}

enum WorkflowAssigneeStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
  SUPERSEDED
}

/// One version of an approval workflow for an entity type at a scope. Versions of the same
/// workflow share `familyId`; at most one version per family is ACTIVE.
model WorkflowDefinition {
  id                String                   @id @default(uuid()) @db.Char(36)
  organizationId    String                   @map("organization_id") @db.Char(36)
  familyId          String                   @map("family_id") @db.Char(36)
  version           Int
  entityType        String                   @map("entity_type") @db.VarChar(64)
  name              String                   @db.VarChar(200)
  description       String?                  @db.VarChar(1000)
  status            WorkflowDefinitionStatus @default(DRAFT)
  scopeType         SettingScopeType         @map("scope_type")
  targetId          String                   @map("target_id") @db.Char(36)
  groupId           String?                  @map("group_id") @db.Char(36)
  institutionId     String?                  @map("institution_id") @db.Char(36)
  /// Array of step definitions (see @erp/shared workflowStepSchema).
  steps             Json
  allowSelfApproval Boolean                  @default(false) @map("allow_self_approval")
  createdById       String?                  @map("created_by_id") @db.Char(36)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instances    WorkflowInstance[]

  @@unique([organizationId, familyId, version])
  @@index([organizationId, entityType, status])
  @@map("workflow_definitions")
}

/// A running / finished approval request for one business entity.
model WorkflowInstance {
  id                String                 @id @default(uuid()) @db.Char(36)
  organizationId    String                 @map("organization_id") @db.Char(36)
  definitionId      String                 @map("definition_id") @db.Char(36)
  definitionVersion Int                    @map("definition_version")
  entityType        String                 @map("entity_type") @db.VarChar(64)
  entityId          String                 @map("entity_id") @db.VarChar(64)
  title             String                 @db.VarChar(300)
  status            WorkflowInstanceStatus @default(PENDING)
  requesterUserId   String?                @map("requester_user_id") @db.Char(36)
  groupId           String?                @map("group_id") @db.Char(36)
  institutionId     String?                @map("institution_id") @db.Char(36)
  departmentId      String?                @map("department_id") @db.Char(36)
  /// Fields used by step conditions and shown to approvers (amount, dates…).
  context           Json
  currentStepOrder  Int?                   @map("current_step_order")
  completedAt       DateTime?              @map("completed_at") @db.DateTime(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition   WorkflowDefinition     @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  steps        WorkflowStepInstance[]
  actions      WorkflowAction[]

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, requesterUserId, status])
  @@index([organizationId, status])
  @@index([definitionId])
  @@map("workflow_instances")
}

model WorkflowStepInstance {
  id             String             @id @default(uuid()) @db.Char(36)
  organizationId String             @map("organization_id") @db.Char(36)
  instanceId     String             @map("instance_id") @db.Char(36)
  stepKey        String             @map("step_key") @db.VarChar(50)
  name           String             @db.VarChar(200)
  order          Int
  mode           String             @db.VarChar(8)
  status         WorkflowStepStatus @default(WAITING)
  /// Snapshot of the step definition at submission time.
  config         Json
  dueAt          DateTime?          @map("due_at") @db.DateTime(3)
  escalatedAt    DateTime?          @map("escalated_at") @db.DateTime(3)
  activatedAt    DateTime?          @map("activated_at") @db.DateTime(3)
  completedAt    DateTime?          @map("completed_at") @db.DateTime(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instance     WorkflowInstance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignees    WorkflowStepAssignee[]

  @@unique([instanceId, order])
  @@index([organizationId, status, dueAt])
  @@map("workflow_step_instances")
}

model WorkflowStepAssignee {
  id                  String                 @id @default(uuid()) @db.Char(36)
  organizationId      String                 @map("organization_id") @db.Char(36)
  stepInstanceId      String                 @map("step_instance_id") @db.Char(36)
  instanceId          String                 @map("instance_id") @db.Char(36)
  userId              String                 @map("user_id") @db.Char(36)
  status              WorkflowAssigneeStatus @default(PENDING)
  delegatedFromUserId String?                @map("delegated_from_user_id") @db.Char(36)
  escalated           Boolean                @default(false)
  actedAt             DateTime?              @map("acted_at") @db.DateTime(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stepInstance WorkflowStepInstance @relation(fields: [stepInstanceId], references: [id], onDelete: Cascade)

  @@unique([stepInstanceId, userId])
  @@index([organizationId, userId, status])
  @@index([instanceId])
  @@map("workflow_step_assignees")
}

/// Append-only history of everything that happened to an instance.
model WorkflowAction {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  instanceId       String   @map("instance_id") @db.Char(36)
  stepInstanceId   String?  @map("step_instance_id") @db.Char(36)
  stepKey          String?  @map("step_key") @db.VarChar(50)
  action           String   @db.VarChar(16)
  actorUserId      String?  @map("actor_user_id") @db.Char(36)
  comment          String?  @db.Text
  delegateToUserId String?  @map("delegate_to_user_id") @db.Char(36)
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instance     WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt])
  @@index([organizationId, actorUserId])
  @@map("workflow_actions")
}

// ---------------------------------------------------------------------------------------------
// Notification engine (Layer 5, core/notifications).
// ---------------------------------------------------------------------------------------------

/// In-app notification for one user.
model Notification {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  eventKey       String    @map("event_key") @db.VarChar(100)
  title          String    @db.VarChar(300)
  body           String?   @db.Text
  link           String?   @db.VarChar(500)
  data           Json?
  readAt         DateTime? @map("read_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, userId, createdAt])
  @@map("notifications")
}

/// Tenant rule: event key → channels / extra recipients / template.
model NotificationRule {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  eventKey       String   @map("event_key") @db.VarChar(100)
  name           String   @db.VarChar(200)
  channels       Json
  recipients     Json
  templateKey    String?  @map("template_key") @db.VarChar(100)
  institutionId  String?  @map("institution_id") @db.Char(36)
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String?  @map("created_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventKey])
  @@map("notification_rules")
}

/// One publish() call; fanned out asynchronously by the queue.
model NotificationJob {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  eventKey       String    @map("event_key") @db.VarChar(100)
  payload        Json
  status         String    @default("PENDING") @db.VarChar(16)
  recipientCount Int       @default(0) @map("recipient_count")
  attempts       Int       @default(0)
  error          String?   @db.VarChar(1000)
  processedAt    DateTime? @map("processed_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("notification_jobs")
}

model NotificationPreference {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  /// Event key or `*`.
  eventKey       String   @map("event_key") @db.VarChar(100)
  channel        String   @db.VarChar(16)
  enabled        Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, eventKey, channel])
  @@map("notification_preferences")
}

/// Mobile push registration (FCM / APNs token).
model PushDevice {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  platform       String   @db.VarChar(8)
  token          String   @db.Text
  tokenHash      String   @map("token_hash") @db.Char(64)
  deviceName     String?  @map("device_name") @db.VarChar(100)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, tokenHash])
  @@index([organizationId, userId])
  @@map("push_devices")
}

// ---------------------------------------------------------------------------------------------
// Communication engine (Layer 5, core/communication). Credentials live in tenant_secrets.
// ---------------------------------------------------------------------------------------------

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SKIPPED
}

model CommunicationProvider {
  id                 String           @id @default(uuid()) @db.Char(36)
  organizationId     String           @map("organization_id") @db.Char(36)
  scopeType          SettingScopeType @map("scope_type")
  targetId           String           @map("target_id") @db.Char(36)
  groupId            String?          @map("group_id") @db.Char(36)
  institutionId      String?          @map("institution_id") @db.Char(36)
  channel            String           @db.VarChar(16)
  providerType       String           @map("provider_type") @db.VarChar(32)
  name               String           @db.VarChar(200)
  priority           Int              @default(100)
  /// Non-secret config (host, port, from, sender id, base URL…).
  config             Json
  /// tenant_secrets row holding the credentials (password / API key / token).
  credentialSecretId String?          @map("credential_secret_id") @db.Char(36)
  /// tenant_secrets row holding the delivery-callback signing secret.
  webhookSecretId    String?          @map("webhook_secret_id") @db.Char(36)
  rateLimitPerMinute Int?             @map("rate_limit_per_minute")
  costPerMessage     Decimal?         @map("cost_per_message") @db.Decimal(12, 4)
  isActive           Boolean          @default(true) @map("is_active")
  createdById        String?          @map("created_by_id") @db.Char(36)
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, channel, isActive])
  @@map("communication_providers")
}

model MessageTemplate {
  id               String           @id @default(uuid()) @db.Char(36)
  organizationId   String           @map("organization_id") @db.Char(36)
  scopeType        SettingScopeType @map("scope_type")
  targetId         String           @map("target_id") @db.Char(36)
  groupId          String?          @map("group_id") @db.Char(36)
  institutionId    String?          @map("institution_id") @db.Char(36)
  key              String           @db.VarChar(100)
  channel          String           @db.VarChar(16)
  name             String           @db.VarChar(200)
  description      String?          @db.VarChar(1000)
  useBrandedLayout Boolean          @default(true) @map("use_branded_layout")
  isActive         Boolean          @default(true) @map("is_active")
  currentVersion   Int              @default(1) @map("current_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     MessageTemplateVersion[]

  @@unique([organizationId, scopeType, targetId, key, channel])
  @@index([organizationId, key, channel])
  @@map("message_templates")
}

/// Immutable template version (message logs reference the version they were rendered from).
model MessageTemplateVersion {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  templateId     String   @map("template_id") @db.Char(36)
  version        Int
  subject        String?  @db.VarChar(500)
  body           String   @db.Text
  htmlBody       String?  @map("html_body") @db.MediumText
  variables      Json
  createdById    String?  @map("created_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template     MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@map("message_template_versions")
}

/// One outbound message to one recipient. Sensitive messages (tokens) never store a body.
model MessageLog {
  id                String        @id @default(uuid()) @db.Char(36)
  organizationId    String        @map("organization_id") @db.Char(36)
  institutionId     String?       @map("institution_id") @db.Char(36)
  channel           String        @db.VarChar(16)
  status            MessageStatus @default(QUEUED)
  recipientAddress  String        @map("recipient_address") @db.VarChar(254)
  recipientUserId   String?       @map("recipient_user_id") @db.Char(36)
  subject           String?       @db.VarChar(500)
  body              String?       @db.Text
  htmlBody          String?       @map("html_body") @db.MediumText
  sensitive         Boolean       @default(false)
  templateKey       String?       @map("template_key") @db.VarChar(100)
  templateVersion   Int?          @map("template_version")
  eventKey          String?       @map("event_key") @db.VarChar(100)
  campaignId        String?       @map("campaign_id") @db.Char(36)
  providerId        String?       @map("provider_id") @db.Char(36)
  providerType      String?       @map("provider_type") @db.VarChar(32)
  providerMessageId String?       @map("provider_message_id") @db.VarChar(255)
  cost              Decimal?      @db.Decimal(12, 4)
  attempts          Int           @default(0)
  lastError         String?       @map("last_error") @db.VarChar(1000)
  metadata          Json?
  createdById       String?       @map("created_by_id") @db.Char(36)
  sentAt            DateTime?     @map("sent_at") @db.DateTime(3)
  deliveredAt       DateTime?     @map("delivered_at") @db.DateTime(3)
  failedAt          DateTime?     @map("failed_at") @db.DateTime(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  events       DeliveryEvent[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([providerId, providerMessageId])
  @@index([campaignId])
  @@map("message_logs")
}

model DeliveryEvent {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  messageLogId   String   @map("message_log_id") @db.Char(36)
  status         String   @db.VarChar(16)
  rawStatus      String?  @map("raw_status") @db.VarChar(64)
  payload        Json?
  occurredAt     DateTime @map("occurred_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  messageLog   MessageLog   @relation(fields: [messageLogId], references: [id], onDelete: Cascade)

  @@index([messageLogId])
  @@map("delivery_events")
}

model Campaign {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  institutionId   String?   @map("institution_id") @db.Char(36)
  name            String    @db.VarChar(200)
  channel         String    @db.VarChar(16)
  status          String    @db.VarChar(16)
  templateKey     String?   @map("template_key") @db.VarChar(100)
  subject         String?   @db.VarChar(500)
  body            String?   @db.Text
  variables       Json
  totalRecipients Int       @default(0) @map("total_recipients")
  sentCount       Int       @default(0) @map("sent_count")
  failedCount     Int       @default(0) @map("failed_count")
  scheduledAt     DateTime? @map("scheduled_at") @db.DateTime(3)
  startedAt       DateTime? @map("started_at") @db.DateTime(3)
  completedAt     DateTime? @map("completed_at") @db.DateTime(3)
  createdById     String?   @map("created_by_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipients   CampaignRecipient[]

  @@index([organizationId, status, scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  campaignId     String   @map("campaign_id") @db.Char(36)
  userId         String?  @map("user_id") @db.Char(36)
  address        String?  @db.VarChar(254)
  name           String?  @db.VarChar(200)
  variables      Json?
  status         String   @default("PENDING") @db.VarChar(16)
  messageLogId   String?  @map("message_log_id") @db.Char(36)
  error          String?  @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------------------------
// Integration framework (Layer 5, core/integrations + core/events).
// ---------------------------------------------------------------------------------------------

/// Machine client (OAuth2 client credentials). Only a SHA-256 hash of the secret is stored.
model ApiClient {
  id                 String           @id @default(uuid()) @db.Char(36)
  organizationId     String           @map("organization_id") @db.Char(36)
  clientId           String           @unique @map("client_id") @db.VarChar(64)
  name               String           @db.VarChar(200)
  description        String?          @db.VarChar(1000)
  secretHash         String           @map("secret_hash") @db.Char(64)
  secretLast4        String           @map("secret_last4") @db.VarChar(4)
  scopeType          SettingScopeType @map("scope_type")
  targetId           String           @map("target_id") @db.Char(36)
  groupId            String?          @map("group_id") @db.Char(36)
  institutionId      String?          @map("institution_id") @db.Char(36)
  rateLimitPerMinute Int              @default(600) @map("rate_limit_per_minute")
  status             String           @default("ACTIVE") @db.VarChar(16)
  lastUsedAt         DateTime?        @map("last_used_at") @db.DateTime(3)
  lastUsedIp         String?          @map("last_used_ip") @db.VarChar(64)
  expiresAt          DateTime?        @map("expires_at") @db.DateTime(3)
  revokedAt          DateTime?        @map("revoked_at") @db.DateTime(3)
  createdById        String?          @map("created_by_id") @db.Char(36)
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scopes       ApiScope[]
  usage        ApiUsage[]

  @@index([organizationId, status])
  @@map("api_clients")
}

/// Permission codes granted to an API client.
model ApiScope {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  apiClientId    String   @map("api_client_id") @db.Char(36)
  scope          String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  apiClient    ApiClient    @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@unique([apiClientId, scope])
  @@index([organizationId])
  @@map("api_scopes")
}

model ApiUsage {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  apiClientId    String   @map("api_client_id") @db.Char(36)
  method         String   @db.VarChar(8)
  path           String   @db.VarChar(500)
  statusCode     Int      @map("status_code")
  durationMs     Int      @map("duration_ms")
  ip             String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  apiClient    ApiClient    @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@index([apiClientId, createdAt])
  @@index([organizationId, createdAt])
  @@map("api_usage")
}

/// Every domain event emitted through core/events (source of webhook deliveries).
model DomainEvent {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  eventKey       String   @map("event_key") @db.VarChar(100)
  payload        Json
  actorType      String?  @map("actor_type") @db.VarChar(16)
  actorId        String?  @map("actor_id") @db.Char(36)
  institutionId  String?  @map("institution_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, eventKey, createdAt])
  @@map("domain_events")
}

/// Outbound webhook subscription. Signing secret lives in tenant_secrets.
model Webhook {
  id                  String    @id @default(uuid()) @db.Char(36)
  organizationId      String    @map("organization_id") @db.Char(36)
  name                String    @db.VarChar(200)
  url                 String    @db.VarChar(2000)
  events              Json
  description         String?   @db.VarChar(1000)
  secretId            String    @map("secret_id") @db.Char(36)
  isActive            Boolean   @default(true) @map("is_active")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime? @map("last_success_at") @db.DateTime(3)
  lastFailureAt       DateTime? @map("last_failure_at") @db.DateTime(3)
  createdById         String?   @map("created_by_id") @db.Char(36)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries   WebhookEvent[]

  @@index([organizationId, isActive])
  @@map("webhooks")
}

/// One delivery of one event to one webhook (with retries / replay).
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  webhookId      String    @map("webhook_id") @db.Char(36)
  eventId        String    @map("event_id") @db.Char(36)
  eventKey       String    @map("event_key") @db.VarChar(100)
  payload        Json
  status         String    @default("PENDING") @db.VarChar(16)
  attempts       Int       @default(0)
  lastStatusCode Int?      @map("last_status_code")
  lastError      String?   @map("last_error") @db.VarChar(1000)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.DateTime(3)
  deliveredAt    DateTime? @map("delivered_at") @db.DateTime(3)
  replayOfId     String?   @map("replay_of_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([organizationId, status, nextAttemptAt])
  @@map("webhook_events")
}

/// Third-party integration credentials (Tally, biometric devices, payment gateways…).
model IntegrationCredential {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  scopeType      SettingScopeType @map("scope_type")
  targetId       String           @map("target_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String?          @map("institution_id") @db.Char(36)
  provider       String           @db.VarChar(50)
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(500)
  config         Json
  secretId       String           @map("secret_id") @db.Char(36)
  isActive       Boolean          @default(true) @map("is_active")
  createdById    String?          @map("created_by_id") @db.Char(36)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scopeType, targetId, provider, name])
  @@map("integration_credentials")
}

// ---------------------------------------------------------------------------------------------
// Layer 6 — HR employee master
// ---------------------------------------------------------------------------------------------

enum EmploymentType {
  TEACHING
  NON_TEACHING
  CONTRACT
  VISITING
  FULL_TIME
  PART_TIME
  INTERN
}

/// Org-defined employee type (e.g. "Consultant", "Trainee"); `category` keeps payroll / leave rules working.
model EmployeeType {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  code           String         @db.VarChar(32)
  name           String         @db.VarChar(200)
  category       EmploymentType
  description    String?        @db.VarChar(1000)
  status         EntityStatus   @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?      @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("employee_types")
}

/// Lifecycle (SPEC §5): DRAFT → ONBOARDING → ACTIVE → ON_NOTICE → EXITED (→ rehire → ONBOARDING).
enum EmployeeStatus {
  DRAFT
  ONBOARDING
  ACTIVE
  ON_NOTICE
  EXITED
}

enum EmployeeMovementType {
  TRANSFER
  PROMOTION
  DESIGNATION_CHANGE
  DEPARTMENT_CHANGE
  REPORTING_CHANGE
  REHIRE
}

enum EmployeeMovementStatus {
  PENDING_APPROVAL
  SCHEDULED
  APPLIED
  REJECTED
  CANCELLED
}

enum EmployeeChecklistKind {
  ONBOARDING
  EXIT
}

enum EmployeeChecklistStatus {
  PENDING
  DONE
  WAIVED
}

enum EmployeeChangeRequestStatus {
  PENDING_APPROVAL
  APPLIED
  REJECTED
  CANCELLED
}

enum EmployeeImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

/// Designation / position master. Both scope columns null = organization-wide designation.
model Designation {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  groupId        String?         @map("group_id") @db.Char(36)
  institutionId  String?         @map("institution_id") @db.Char(36)
  /// Optional department this role belongs to (e.g. IT → Frontend developer).
  departmentId   String?         @map("department_id") @db.Char(36)
  code           String          @db.VarChar(32)
  name           String          @db.VarChar(200)
  category       EmploymentType?
  /// Grade / band rank (higher = more senior); used to label promotions.
  level          Int?
  description    String?         @db.VarChar(1000)
  status         EntityStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?       @map("deleted_at") @db.DateTime(3)

  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees    Employee[]
  positions    EmployeePosition[]

  @@unique([organizationId, code])
  @@index([organizationId, departmentId])
  @@index([organizationId, institutionId])
  @@index([organizationId, deletedAt])
  @@map("designations")
}

/// Employee code numbering per institution (`scope_key` = institution id, or `default`).
model EmployeeCodeSequence {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  scopeKey       String   @map("scope_key") @db.VarChar(36)
  prefix         String   @db.VarChar(20)
  padding        Int      @default(4)
  nextNumber     Int      @default(1) @map("next_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scopeKey])
  @@map("employee_code_sequences")
}

/// Employee master with the CURRENT assignment (history lives in the employee_* history tables).
model Employee {
  id                 String         @id @default(uuid()) @db.Char(36)
  organizationId     String         @map("organization_id") @db.Char(36)
  employeeCode       String         @map("employee_code") @db.VarChar(40)
  userId             String?        @map("user_id") @db.Char(36)
  groupId            String?        @map("group_id") @db.Char(36)
  institutionId      String         @map("institution_id") @db.Char(36)
  campusId           String?        @map("campus_id") @db.Char(36)
  departmentId       String?        @map("department_id") @db.Char(36)
  designationId      String?        @map("designation_id") @db.Char(36)
  reportingManagerId String?        @map("reporting_manager_id") @db.Char(36)
  employmentType     EmploymentType @map("employment_type")
  employeeTypeId     String?        @map("employee_type_id") @db.Char(36)
  /// Profile photo (document id) and its face descriptor (128 floats) used for selfie punches.
  photoDocumentId    String?        @map("photo_document_id") @db.Char(36)
  faceDescriptor     Json?          @map("face_descriptor")
  status             EmployeeStatus @default(DRAFT)
  firstName          String         @map("first_name") @db.VarChar(100)
  middleName         String?        @map("middle_name") @db.VarChar(100)
  lastName           String?        @map("last_name") @db.VarChar(100)
  displayName        String         @map("display_name") @db.VarChar(200)
  workEmail          String?        @map("work_email") @db.VarChar(254)
  workPhone          String?        @map("work_phone") @db.VarChar(32)
  dateOfJoining      DateTime?      @map("date_of_joining") @db.Date
  probationEndDate   DateTime?      @map("probation_end_date") @db.Date
  confirmationDate   DateTime?      @map("confirmation_date") @db.Date
  noticePeriodDays   Int?           @map("notice_period_days")
  resignationDate    DateTime?      @map("resignation_date") @db.Date
  lastWorkingDate    DateTime?      @map("last_working_date") @db.Date
  exitDate           DateTime?      @map("exit_date") @db.Date
  exitType           String?        @map("exit_type") @db.VarChar(32)
  exitReason         String?        @map("exit_reason") @db.VarChar(1000)
  rehireCount        Int            @default(0) @map("rehire_count")
  createdAt          DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime?      @map("deleted_at") @db.DateTime(3)

  organization     Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User?                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  group            Group?                         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution      Institution                    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus           Campus?                        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  department       Department?                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation      Designation?                   @relation(fields: [designationId], references: [id], onDelete: Restrict)
  employeeType     EmployeeType?                  @relation(fields: [employeeTypeId], references: [id], onDelete: Restrict)
  reportingManager Employee?                      @relation("EmployeeReportingManager", fields: [reportingManagerId], references: [id], onDelete: Restrict)
  directReports    Employee[]                     @relation("EmployeeReportingManager")
  profile          EmployeeProfile?
  positions        EmployeePosition[]
  departments      EmployeeDepartment[]
  reportingLines   EmployeeReportingLine[]        @relation("ReportingLineEmployee")
  managedLines     EmployeeReportingLine[]        @relation("ReportingLineManager")
  movements        EmployeeMovement[]
  salaryHistory    EmployeeSalaryHistory[]
  checklistItems   EmployeeChecklistItem[]
  changeRequests   EmployeeProfileChangeRequest[]
  shiftAssignments ShiftAssignment[]
  punches          AttendancePunch[]
  attendance       AttendanceRecord[]
  regularizations  AttendanceRegularization[]
  leaveLedger      LeaveLedgerEntry[]
  leaveRequests    LeaveRequest[]

  custodyAssets    Asset[]
  assetAssignments AssetAssignment[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, userId])
  @@index([organizationId, employeeTypeId])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, groupId])
  @@index([organizationId, departmentId])
  @@index([organizationId, reportingManagerId])
  @@index([organizationId, deletedAt])
  @@map("employees")
}

/// Personal profile. Statutory ids + bank details are ONE envelope-encrypted JSON blob
/// (core/secrets, AAD = org + employee); only masks and keyed blind indexes are stored in clear.
model EmployeeProfile {
  id                   String    @id @default(uuid()) @db.Char(36)
  organizationId       String    @map("organization_id") @db.Char(36)
  employeeId           String    @unique @map("employee_id") @db.Char(36)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  gender               String?   @db.VarChar(16)
  maritalStatus        String?   @map("marital_status") @db.VarChar(16)
  bloodGroup           String?   @map("blood_group") @db.VarChar(8)
  nationality          String?   @db.VarChar(64)
  personalEmail        String?   @map("personal_email") @db.VarChar(254)
  personalPhone        String?   @map("personal_phone") @db.VarChar(32)
  addresses            Json?
  emergencyContacts    Json?     @map("emergency_contacts")
  family               Json?
  qualifications       Json?
  experience           Json?
  sensitiveCiphertext  String?   @map("sensitive_ciphertext") @db.Text
  sensitiveWrappedKey  String?   @map("sensitive_wrapped_key") @db.VarChar(512)
  sensitiveKeyVersion  Int?      @map("sensitive_key_version")
  sensitiveKeyProvider String?   @map("sensitive_key_provider") @db.VarChar(32)
  /// Masked display values (e.g. `••••••1234F`) — safe to return by default.
  sensitiveMasked      Json?     @map("sensitive_masked")
  panIndex             String?   @map("pan_index") @db.VarChar(64)
  aadhaarIndex         String?   @map("aadhaar_index") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, panIndex])
  @@unique([organizationId, aadhaarIndex])
  @@map("employee_profiles")
}

/// Designation / position history (effective-dated; open row has effective_to = null).
model EmployeePosition {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  employeeId     String         @map("employee_id") @db.Char(36)
  groupId        String?        @map("group_id") @db.Char(36)
  institutionId  String         @map("institution_id") @db.Char(36)
  designationId  String?        @map("designation_id") @db.Char(36)
  employmentType EmploymentType @map("employment_type")
  effectiveFrom  DateTime       @map("effective_from") @db.Date
  effectiveTo    DateTime?      @map("effective_to") @db.Date
  reason         String?        @db.VarChar(500)
  movementId     String?        @map("movement_id") @db.Char(36)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, institutionId])
  @@map("employee_positions")
}

/// Department / institution assignment history, including secondary departments.
model EmployeeDepartment {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  employeeId     String    @map("employee_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  campusId       String?   @map("campus_id") @db.Char(36)
  departmentId   String?   @map("department_id") @db.Char(36)
  isPrimary      Boolean   @default(true) @map("is_primary")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  movementId     String?   @map("movement_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@map("employee_departments")
}

/// Reporting manager history.
model EmployeeReportingLine {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  employeeId     String    @map("employee_id") @db.Char(36)
  managerId      String    @map("manager_id") @db.Char(36)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  movementId     String?   @map("movement_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation("ReportingLineEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  manager      Employee     @relation("ReportingLineManager", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, managerId])
  @@map("employee_reporting_lines")
}

/// Transfer / promotion / designation, department or reporting change (effective-dated).
/// `from_*` columns snapshot the assignment before the movement.
model EmployeeMovement {
  id                     String                 @id @default(uuid()) @db.Char(36)
  organizationId         String                 @map("organization_id") @db.Char(36)
  employeeId             String                 @map("employee_id") @db.Char(36)
  type                   EmployeeMovementType
  status                 EmployeeMovementStatus @default(PENDING_APPROVAL)
  effectiveDate          DateTime               @map("effective_date") @db.Date
  fromGroupId            String?                @map("from_group_id") @db.Char(36)
  fromInstitutionId      String                 @map("from_institution_id") @db.Char(36)
  fromCampusId           String?                @map("from_campus_id") @db.Char(36)
  fromDepartmentId       String?                @map("from_department_id") @db.Char(36)
  fromDesignationId      String?                @map("from_designation_id") @db.Char(36)
  fromReportingManagerId String?                @map("from_reporting_manager_id") @db.Char(36)
  toGroupId              String?                @map("to_group_id") @db.Char(36)
  toInstitutionId        String                 @map("to_institution_id") @db.Char(36)
  toCampusId             String?                @map("to_campus_id") @db.Char(36)
  toDepartmentId         String?                @map("to_department_id") @db.Char(36)
  toDesignationId        String?                @map("to_designation_id") @db.Char(36)
  toReportingManagerId   String?                @map("to_reporting_manager_id") @db.Char(36)
  reason                 String?                @db.VarChar(1000)
  workflowInstanceId     String?                @map("workflow_instance_id") @db.Char(36)
  requestedByUserId      String?                @map("requested_by_user_id") @db.Char(36)
  decidedComment         String?                @map("decided_comment") @db.VarChar(1000)
  appliedAt              DateTime?              @map("applied_at") @db.DateTime(3)
  createdAt              DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveDate])
  @@index([organizationId, status, effectiveDate])
  @@index([organizationId, fromInstitutionId])
  @@index([organizationId, toInstitutionId])
  @@map("employee_movements")
}

/// Effective-dated salary / CTC revisions. IMMUTABLE (DB triggers): a revision is a new row.
/// Layer 8 (payroll) sets `salary_structure_id` and reads `amounts` (component → amount).
model EmployeeSalaryHistory {
  id                String   @id @default(uuid()) @db.Char(36)
  organizationId    String   @map("organization_id") @db.Char(36)
  employeeId        String   @map("employee_id") @db.Char(36)
  groupId           String?  @map("group_id") @db.Char(36)
  institutionId     String   @map("institution_id") @db.Char(36)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  currency          String   @default("INR") @db.VarChar(3)
  annualCtc         Decimal  @map("annual_ctc") @db.Decimal(14, 2)
  /// Free-form component amounts, e.g. `{ "basic": 30000, "hra": 12000 }` (monthly).
  amounts           Json
  salaryStructureId String?  @map("salary_structure_id") @db.VarChar(64)
  revisionReason    String   @map("revision_reason") @db.VarChar(500)
  previousId        String?  @map("previous_id") @db.Char(36)
  createdByUserId   String?  @map("created_by_user_id") @db.Char(36)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, institutionId])
  @@map("employee_salary_history")
}

/// Onboarding / exit checklist tasks. `source` = `default`, `manual` or a hook key
/// (e.g. `assets.recovery` registered by the asset module).
model EmployeeChecklistItem {
  id                String                  @id @default(uuid()) @db.Char(36)
  organizationId    String                  @map("organization_id") @db.Char(36)
  employeeId        String                  @map("employee_id") @db.Char(36)
  kind              EmployeeChecklistKind
  key               String                  @db.VarChar(64)
  title             String                  @db.VarChar(200)
  source            String                  @default("default") @db.VarChar(64)
  status            EmployeeChecklistStatus @default(PENDING)
  notes             String?                 @db.VarChar(1000)
  completedAt       DateTime?               @map("completed_at") @db.DateTime(3)
  completedByUserId String?                 @map("completed_by_user_id") @db.Char(36)
  createdAt         DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, kind, key])
  @@map("employee_checklist_items")
}

/// Employee self-service profile change request (workflow `employee_profile_change`).
model EmployeeProfileChangeRequest {
  id                 String                      @id @default(uuid()) @db.Char(36)
  organizationId     String                      @map("organization_id") @db.Char(36)
  employeeId         String                      @map("employee_id") @db.Char(36)
  status             EmployeeChangeRequestStatus @default(PENDING_APPROVAL)
  /// Requested personal field values (non-sensitive fields only).
  changes            Json
  reason             String?                     @db.VarChar(1000)
  workflowInstanceId String?                     @map("workflow_instance_id") @db.Char(36)
  requestedByUserId  String?                     @map("requested_by_user_id") @db.Char(36)
  decidedComment     String?                     @map("decided_comment") @db.VarChar(1000)
  appliedAt          DateTime?                   @map("applied_at") @db.DateTime(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, status])
  @@map("employee_profile_change_requests")
}

/// CSV bulk import run (queue job `hr.employee_import`) with its validation report.
model EmployeeImportJob {
  id                String               @id @default(uuid()) @db.Char(36)
  organizationId    String               @map("organization_id") @db.Char(36)
  status            EmployeeImportStatus @default(QUEUED)
  fileName          String               @map("file_name") @db.VarChar(255)
  dryRun            Boolean              @default(false) @map("dry_run")
  /// Raw CSV (bounded by the upload limit); cleared once processed.
  input             String?              @db.MediumText
  totalRows         Int                  @default(0) @map("total_rows")
  createdCount      Int                  @default(0) @map("created_count")
  errorCount        Int                  @default(0) @map("error_count")
  /// `[{ row, employeeCode?, errors: [{ field, message }] , employeeId? }]`
  report            Json?
  requestedByUserId String?              @map("requested_by_user_id") @db.Char(36)
  startedAt         DateTime?            @map("started_at") @db.DateTime(3)
  completedAt       DateTime?            @map("completed_at") @db.DateTime(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("employee_import_jobs")
}

// ============================================================================================
// Attendance / leave / holiday / shift foundation (Layer 7)
// ============================================================================================

enum HolidayCalendarScope {
  ORGANIZATION
  GROUP
  INSTITUTION
  CAMPUS
}

enum HolidayType {
  PUBLIC
  RESTRICTED
  OPTIONAL
}

/// Holiday calendar of one year at one level (org default → group → institution → campus).
/// Lower levels inherit everything from higher ones and may add / suppress holidays and
/// override the weekly-off pattern. `scopeKey` = `ORG` or the group / institution / campus id.
model HolidayCalendar {
  id             String               @id @default(uuid()) @db.Char(36)
  organizationId String               @map("organization_id") @db.Char(36)
  scope          HolidayCalendarScope
  scopeKey       String               @map("scope_key") @db.VarChar(36)
  groupId        String?              @map("group_id") @db.Char(36)
  institutionId  String?              @map("institution_id") @db.Char(36)
  campusId       String?              @map("campus_id") @db.Char(36)
  year           Int
  name           String               @db.VarChar(200)
  /// `[{ weekday: 0..6, weeks?: [1..5] }]`; null = inherit from the parent calendar.
  weeklyOffs     Json?                @map("weekly_offs")
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  holidays     Holiday[]

  @@unique([organizationId, scopeKey, year])
  @@index([organizationId, year, scope])
  @@index([organizationId, institutionId])
  @@map("holiday_calendars")
}

model Holiday {
  id             String      @id @default(uuid()) @db.Char(36)
  organizationId String      @map("organization_id") @db.Char(36)
  calendarId     String      @map("calendar_id") @db.Char(36)
  date           DateTime    @db.Date
  name           String      @db.VarChar(200)
  type           HolidayType @default(PUBLIC)
  /// Override entry: suppresses an inherited holiday on this date.
  removed        Boolean     @default(false)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  calendar     HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([organizationId, date])
  @@map("holidays")
}

enum ShiftStatus {
  ACTIVE
  INACTIVE
}

/// Work shift of an institution. Times are minutes after local midnight; `endMinute <=
/// startMinute` means the shift crosses midnight.
model Shift {
  id                   String      @id @default(uuid()) @db.Char(36)
  organizationId       String      @map("organization_id") @db.Char(36)
  institutionId        String      @map("institution_id") @db.Char(36)
  code                 String      @db.VarChar(32)
  name                 String      @db.VarChar(200)
  startMinute          Int         @map("start_minute")
  endMinute            Int         @map("end_minute")
  crossesMidnight      Boolean     @default(false) @map("crosses_midnight")
  graceInMinutes       Int         @default(0) @map("grace_in_minutes")
  graceOutMinutes      Int         @default(0) @map("grace_out_minutes")
  breakMinutes         Int         @default(0) @map("break_minutes")
  halfDayMinutes       Int         @default(240) @map("half_day_minutes")
  fullDayMinutes       Int         @default(480) @map("full_day_minutes")
  overtimeAfterMinutes Int         @default(0) @map("overtime_after_minutes")
  weeklyOffs           Json?       @map("weekly_offs")
  isDefault            Boolean     @default(false) @map("is_default")
  status               ShiftStatus @default(ACTIVE)
  createdAt            DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  assignments  ShiftAssignment[]

  @@unique([organizationId, institutionId, code])
  @@index([organizationId, institutionId, isDefault])
  @@map("shifts")
}

/// Effective-dated shift of an employee (wins) or a department; optional basic rotation.
model ShiftAssignment {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  institutionId    String    @map("institution_id") @db.Char(36)
  employeeId       String?   @map("employee_id") @db.Char(36)
  departmentId     String?   @map("department_id") @db.Char(36)
  shiftId          String    @map("shift_id") @db.Char(36)
  /// `[shiftId, ...]` cycled every `rotationDays` days from `effectiveFrom`.
  rotationShiftIds Json?     @map("rotation_shift_ids")
  rotationDays     Int?      @map("rotation_days")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  createdByUserId  String?   @map("created_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shift        Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, departmentId, effectiveFrom])
  @@map("shift_assignments")
}

enum PunchSource {
  WEB
  MOBILE
  BIOMETRIC
  API
  MANUAL
}

enum PunchDirection {
  IN
  OUT
  UNKNOWN
}

/// Raw punch (append-only). `attendanceDate` is the local shift day the punch belongs to.
model AttendancePunch {
  id               String         @id @default(uuid()) @db.Char(36)
  organizationId   String         @map("organization_id") @db.Char(36)
  employeeId       String         @map("employee_id") @db.Char(36)
  punchedAt        DateTime       @map("punched_at") @db.DateTime(3)
  attendanceDate   DateTime       @map("attendance_date") @db.Date
  direction        PunchDirection @default(UNKNOWN)
  source           PunchSource
  deviceId         String?        @map("device_id") @db.VarChar(100)
  latitude         Decimal?       @db.Decimal(9, 6)
  longitude        Decimal?       @db.Decimal(9, 6)
  accuracyMeters   Decimal?       @map("accuracy_meters") @db.Decimal(10, 2)
  importJobId      String?        @map("import_job_id") @db.Char(36)
  selfieDocumentId String?        @map("selfie_document_id") @db.Char(36)
  faceDistance     Decimal?       @map("face_distance") @db.Decimal(6, 4)
