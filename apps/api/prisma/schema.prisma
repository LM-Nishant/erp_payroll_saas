/// Bed allocation. At most one ACTIVE allocation per bed and per occupant (enforced in the service).
model HostelAllocation {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  hostelId       String    @map("hostel_id") @db.Char(36)
  roomId         String    @map("room_id") @db.Char(36)
  bedId          String    @map("bed_id") @db.Char(36)
  occupantType   String    @map("occupant_type") @db.VarChar(16)
  studentId      String?   @map("student_id") @db.Char(36)
  employeeId     String?   @map("employee_id") @db.Char(36)
  messPlanId     String?   @map("mess_plan_id") @db.Char(36)
  fromDate       DateTime  @map("from_date") @db.Date
  toDate         DateTime? @map("to_date") @db.Date
  status         String    @default("ACTIVE") @db.VarChar(16)
  monthlyRent    Decimal   @default(0) @map("monthly_rent") @db.Decimal(12, 2)
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hostel       Hostel          @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  room         HostelRoom      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bed          HostelBed       @relation(fields: [bedId], references: [id], onDelete: Restrict)
  messPlan     HostelMessPlan? @relation(fields: [messPlanId], references: [id], onDelete: Restrict)
  charges      HostelCharge[]

  @@index([organizationId, hostelId, status])
  @@index([organizationId, studentId, status])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, bedId, status])
  @@map("hostel_allocations")
}

model HostelCharge {
  id             String   @id @default(uuid()) @db.Char(36)
