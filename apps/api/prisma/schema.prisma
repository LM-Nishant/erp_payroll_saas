enum LeaveStatus {
  ACTIVE
  INACTIVE
}

model LeaveType {
  id                   String      @id @default(uuid()) @db.Char(36)
  organizationId       String      @map("organization_id") @db.Char(36)
  code                 String      @db.VarChar(32)
  name                 String      @db.VarChar(200)
  isPaid               Boolean     @default(true) @map("is_paid")
  allowHalfDay         Boolean     @default(true) @map("allow_half_day")
  /// `["FEMALE", ...]`; null = all.
  genders              Json?
  /// `["TEACHING", ...]`; null = all.
  employmentTypes      Json?       @map("employment_types")
  requiresDocument     Boolean     @default(false) @map("requires_document")
  documentAfterDays    Decimal     @default(0) @map("document_after_days") @db.Decimal(6, 2)
  sandwichRule         Boolean     @default(false) @map("sandwich_rule")
  encashable           Boolean     @default(false)
  maxEncashDays        Decimal?    @map("max_encash_days") @db.Decimal(6, 2)
  maxCarryForward      Decimal?    @map("max_carry_forward") @db.Decimal(6, 2)
  allowNegativeBalance Boolean     @default(false) @map("allow_negative_balance")
  status               LeaveStatus @default(ACTIVE)
  createdAt            DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policyRules  LeavePolicyRule[]
  ledger       LeaveLedgerEntry[]
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@map("leave_types")
}

enum AccrualFrequency {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Leave policy scoped to an institution, else a group, else the organization (both null), and an
/// employment type (null = all). The most specific active policy applies to an employee:
/// institution+type > institution > group+type > group > org+type > org.
model LeavePolicy {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  name           String          @db.VarChar(200)
  groupId        String?         @map("group_id") @db.Char(36)
  institutionId  String?         @map("institution_id") @db.Char(36)
  employmentType EmploymentType? @map("employment_type")
  status         LeaveStatus     @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution?      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  rules        LeavePolicyRule[]

  @@index([organizationId, institutionId, employmentType])
  @@index([organizationId, groupId])
  @@map("leave_policies")
}

model LeavePolicyRule {
  id                  String           @id @default(uuid()) @db.Char(36)
  organizationId      String           @map("organization_id") @db.Char(36)
  policyId            String           @map("policy_id") @db.Char(36)
  leaveTypeId         String           @map("leave_type_id") @db.Char(36)
  accrualFrequency    AccrualFrequency @map("accrual_frequency")
  annualQuota         Decimal          @map("annual_quota") @db.Decimal(6, 2)
  proRataOnJoining    Boolean          @default(true) @map("pro_rata_on_joining")
  maxCarryForward     Decimal?         @map("max_carry_forward") @db.Decimal(6, 2)
  // Application rules; null = inherit the leave type default (see @erp/shared leave schemas).
  /// NONE | WEEKLY_OFFS | HOLIDAYS | BOTH (null = LeaveType.sandwichRule).
  sandwichMode        String?          @map("sandwich_mode") @db.VarChar(16)
  sandwichMinDays     Decimal?         @map("sandwich_min_days") @db.Decimal(6, 2)
  sandwichAdjacent    Boolean?         @map("sandwich_adjacent")
  minNoticeDays       Int?             @map("min_notice_days")
  /// `[{ minDays, noticeDays }]`
  noticeTiers         Json?            @map("notice_tiers")
  maxAdvanceDays      Int?             @map("max_advance_days")
  allowBackdated      Boolean?         @map("allow_backdated")
  backdatedMaxDays    Int?             @map("backdated_max_days")
  minDaysPerRequest   Decimal?         @map("min_days_per_request") @db.Decimal(6, 2)
  maxConsecutiveDays  Decimal?         @map("max_consecutive_days") @db.Decimal(6, 2)
  maxRequestsPerMonth Int?             @map("max_requests_per_month")
  maxDaysPerMonth     Decimal?         @map("max_days_per_month") @db.Decimal(6, 2)
  /// Leave type codes, e.g. `["EL"]`.
  notClubbableWith    Json?            @map("not_clubbable_with")
  createdAt           DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy       LeavePolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([policyId, leaveTypeId])
  @@index([organizationId, leaveTypeId])
  @@map("leave_policy_rules")
}

enum LeaveLedgerEntryType {
  ACCRUAL
  CONSUMPTION
  ADJUSTMENT
  CARRY_FORWARD
  LAPSE
  ENCASHMENT
  REVERSAL
}

/// Append-only leave balance ledger; balance = SUM(days). `periodKey` makes system entries
/// idempotent (e.g. accrual `2026-03`, year-end `YE-2026`).
model LeaveLedgerEntry {
  id              String               @id @default(uuid()) @db.Char(36)
  organizationId  String               @map("organization_id") @db.Char(36)
  employeeId      String               @map("employee_id") @db.Char(36)
  leaveTypeId     String               @map("leave_type_id") @db.Char(36)
  entryType       LeaveLedgerEntryType @map("entry_type")
  days            Decimal              @db.Decimal(7, 2)
  effectiveDate   DateTime             @map("effective_date") @db.Date
  periodKey       String?              @map("period_key") @db.VarChar(32)
  leaveRequestId  String?              @map("leave_request_id") @db.Char(36)
  reason          String?              @db.VarChar(500)
  createdByUserId String?              @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, leaveTypeId, entryType, periodKey])
  @@index([organizationId, employeeId, leaveTypeId, effectiveDate])
  @@index([organizationId, leaveRequestId])
  @@map("leave_ledger_entries")
}

enum LeaveRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// Leave request (workflow `leave_request`). `breakdown` = `[{ date, days, kind, sandwiched }]`
/// computed at application time (holidays / weekly offs / half days / sandwich rule).
model LeaveRequest {
  id                 String             @id @default(uuid()) @db.Char(36)
  organizationId     String             @map("organization_id") @db.Char(36)
  employeeId         String             @map("employee_id") @db.Char(36)
  leaveTypeId        String             @map("leave_type_id") @db.Char(36)
  groupId            String?            @map("group_id") @db.Char(36)
  institutionId      String             @map("institution_id") @db.Char(36)
  campusId           String?            @map("campus_id") @db.Char(36)
  departmentId       String?            @map("department_id") @db.Char(36)
  fromDate           DateTime           @map("from_date") @db.Date
  toDate             DateTime           @map("to_date") @db.Date
  startHalf          Boolean            @default(false) @map("start_half")
  endHalf            Boolean            @default(false) @map("end_half")
  days               Decimal            @db.Decimal(6, 2)
  breakdown          Json
  reason             String             @db.VarChar(1000)
  documentId         String?            @map("document_id") @db.Char(36)
  status             LeaveRequestStatus @default(PENDING_APPROVAL)
  workflowInstanceId String?            @map("workflow_instance_id") @db.Char(36)
  appliedByUserId    String?            @map("applied_by_user_id") @db.Char(36)
  /// HR override of leave policy rule violations (reason; violations are in the audit log).
  ruleOverrideReason String?            @map("rule_override_reason") @db.VarChar(500)
  decidedComment     String?            @map("decided_comment") @db.VarChar(1000)
  cancelReason       String?            @map("cancel_reason") @db.VarChar(1000)
  cancelledAt        DateTime?          @map("cancelled_at") @db.DateTime(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, fromDate, toDate])
  @@index([organizationId, institutionId, status])
  @@map("leave_requests")
}

// ============================================================================================
// Layer 8 — Payroll rule engine (§13-20, §53, §57). Money = Decimal(14,2), monthly amounts.
// Enumerations are VARCHAR validated by @erp/shared zod schemas. Finalized payroll is protected
// by DB triggers (see migration `payroll_rule_engine`).
// ============================================================================================

/// Salary component master. `institutionId` null = organization default; `scopeKey` is `ORG` or
/// the institution id so (organization, scope, code) is unique per policy scope (acceptance 7).
model SalaryComponent {
  id                String   @id @default(uuid()) @db.Char(36)
  organizationId    String   @map("organization_id") @db.Char(36)
  institutionId     String?  @map("institution_id") @db.Char(36)
  scopeKey          String   @map("scope_key") @db.VarChar(36)
  code              String   @db.VarChar(32)
  name              String   @db.VarChar(200)
  type              String   @db.VarChar(32)
  calcType          String   @map("calc_type") @db.VarChar(16)
  amount            Decimal? @db.Decimal(14, 2)
  percentage        Decimal? @db.Decimal(9, 4)
  percentOf         String?  @map("percent_of") @db.VarChar(32)
  formula           String?  @db.Text
  slabBasis         String?  @map("slab_basis") @db.VarChar(32)
  slabs             Json?
  statutoryCode     String?  @map("statutory_code") @db.VarChar(16)
  taxable           Boolean  @default(true)
  proRated          Boolean  @default(true) @map("pro_rated")
  rounding          String   @default("NEAREST") @db.VarChar(16)
  roundingPrecision Int      @default(0) @map("rounding_precision")
  displayOrder      Int      @default(100) @map("display_order")
  showOnPayslip     Boolean  @default(true) @map("show_on_payslip")
  description       String?  @db.VarChar(500)
  status            String   @default("ACTIVE") @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scopeKey, code])
  @@index([organizationId, institutionId])
  @@map("salary_components")
}

/// Effective-dated, versioned calculation override of a component (immutable rows; a new
/// version supersedes older ones from its `effectiveFrom`).
model SalaryRule {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  institutionId   String?  @map("institution_id") @db.Char(36)
  scopeKey        String   @map("scope_key") @db.VarChar(36)
  componentCode   String   @map("component_code") @db.VarChar(32)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  version         Int
  calcType        String   @map("calc_type") @db.VarChar(16)
  amount          Decimal? @db.Decimal(14, 2)
  percentage      Decimal? @db.Decimal(9, 4)
  percentOf       String?  @map("percent_of") @db.VarChar(32)
  formula         String?  @db.Text
  slabBasis       String?  @map("slab_basis") @db.VarChar(32)
  slabs           Json?
  condition       String?  @db.Text
  notes           String?  @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scopeKey, componentCode, version])
  @@index([organizationId, scopeKey, componentCode, effectiveFrom])
  @@map("salary_rules")
}

/// Salary structure template per institution / grade / employment type.
model SalaryStructure {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(200)
  employmentType String?  @map("employment_type") @db.VarChar(32)
  grade          String?  @db.VarChar(64)
  description    String?  @db.VarChar(500)
  status         String   @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     SalaryStructureVersion[]

  @@unique([organizationId, institutionId, code])
  @@map("salary_structures")
}

/// Immutable effective-dated version of a structure (`lines` = component calc overrides).
model SalaryStructureVersion {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  structureId     String   @map("structure_id") @db.Char(36)
  version         Int
  effectiveFrom   DateTime @map("effective_from") @db.Date
  lines           Json
  notes           String?  @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  structure    SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)

  @@unique([structureId, version])
  @@unique([structureId, effectiveFrom])
  @@index([organizationId, structureId])
  @@map("salary_structure_versions")
}

/// Per-institution payroll policy (statutory toggles, PT / LWF state, attendance-lock gate).
model PayrollSetting {
  id                    String   @id @default(uuid()) @db.Char(36)
  organizationId        String   @map("organization_id") @db.Char(36)
  institutionId         String   @map("institution_id") @db.Char(36)
  state                 String?  @db.VarChar(8)
  pfEnabled             Boolean  @default(true) @map("pf_enabled")
  esiEnabled            Boolean  @default(true) @map("esi_enabled")
  ptEnabled             Boolean  @default(true) @map("pt_enabled")
  tdsEnabled            Boolean  @default(true) @map("tds_enabled")
  lwfEnabled            Boolean  @default(false) @map("lwf_enabled")
  requireAttendanceLock Boolean  @default(true) @map("require_attendance_lock")
  payDay                Int?     @map("pay_day")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, institutionId])
  @@map("payroll_settings")
}

/// Versioned statutory rule pack override (PF / ESI / PT / TDS / LWF) per financial year + region.
model StatutoryRulePack {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  pack            String   @db.VarChar(8)
  financialYear   String   @map("financial_year") @db.VarChar(7)
  region          String   @default("IN") @db.VarChar(8)
  version         Int
  config          Json
  notes           String?  @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, pack, financialYear, region, version])
  @@map("statutory_rule_packs")
}

/// Employee salary assignment: links an immutable `employee_salary_history` row (whose
/// `salary_structure_id` is the structure id) with payroll inputs (structure, tax regime).
model EmployeeSalary {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  employeeId      String   @map("employee_id") @db.Char(36)
  institutionId   String   @map("institution_id") @db.Char(36)
  structureId     String   @map("structure_id") @db.Char(36)
  salaryHistoryId String   @unique @map("salary_history_id") @db.Char(36)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  annualCtc       Decimal  @map("annual_ctc") @db.Decimal(14, 2)
  amounts         Json
  taxRegime       String   @default("NEW") @map("tax_regime") @db.VarChar(8)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@map("employee_salaries")
}

/// Salary revision request (§16) approved via workflow `salary_revision`; back-dated revisions
/// create ARREAR adjustments for already-finalized periods.
model SalaryRevision {
  id                 String    @id @default(uuid()) @db.Char(36)
  organizationId     String    @map("organization_id") @db.Char(36)
  employeeId         String    @map("employee_id") @db.Char(36)
  institutionId      String    @map("institution_id") @db.Char(36)
  groupId            String?   @map("group_id") @db.Char(36)
  structureId        String?   @map("structure_id") @db.Char(36)
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  annualCtc          Decimal   @map("annual_ctc") @db.Decimal(14, 2)
  previousAnnualCtc  Decimal?  @map("previous_annual_ctc") @db.Decimal(14, 2)
  amounts            Json
  taxRegime          String?   @map("tax_regime") @db.VarChar(8)
  reason             String    @db.VarChar(500)
  status             String    @default("PENDING_APPROVAL") @db.VarChar(24)
  workflowInstanceId String?   @map("workflow_instance_id") @db.Char(36)
  salaryHistoryId    String?   @map("salary_history_id") @db.Char(36)
  arrearsAmount      Decimal   @default(0) @map("arrears_amount") @db.Decimal(14, 2)
  arrears            Json?
  decidedComment     String?   @map("decided_comment") @db.VarChar(1000)
  requestedByUserId  String?   @map("requested_by_user_id") @db.Char(36)
  decidedAt          DateTime? @map("decided_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, status])
  @@map("salary_revisions")
}

/// Group-level payroll batch (§53): one run per institution for the same period.
model PayrollBatch {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  groupId         String   @map("group_id") @db.Char(36)
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  label           String   @db.VarChar(120)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  runs         PayrollRun[]

  @@index([organizationId, groupId, periodStart])
  @@map("payroll_batches")
}

/// Payroll run per institution + period. Lifecycle DRAFT → COMPUTING → COMPUTED →
/// PENDING_APPROVAL → APPROVED → FINALIZED (→ REOPENED, superseded by revision + 1).
model PayrollRun {
  id                  String    @id @default(uuid()) @db.Char(36)
  organizationId      String    @map("organization_id") @db.Char(36)
  institutionId       String    @map("institution_id") @db.Char(36)
  groupId             String?   @map("group_id") @db.Char(36)
  batchId             String?   @map("batch_id") @db.Char(36)
  periodStart         DateTime  @map("period_start") @db.Date
  periodEnd           DateTime  @map("period_end") @db.Date
  label               String    @db.VarChar(120)
  status              String    @default("DRAFT") @db.VarChar(24)
  revision            Int       @default(1)
  previousRunId       String?   @map("previous_run_id") @db.Char(36)
  attendanceLocked    Boolean   @default(false) @map("attendance_locked")
  employeeCount       Int       @default(0) @map("employee_count")
  errorCount          Int       @default(0) @map("error_count")
  grossTotal          Decimal   @default(0) @map("gross_total") @db.Decimal(16, 2)
  deductionTotal      Decimal   @default(0) @map("deduction_total") @db.Decimal(16, 2)
  netTotal            Decimal   @default(0) @map("net_total") @db.Decimal(16, 2)
  employerTotal       Decimal   @default(0) @map("employer_total") @db.Decimal(16, 2)
  pendingBatches      Int       @default(0) @map("pending_batches")
  computeToken        String?   @map("compute_token") @db.Char(36)
  workflowInstanceId  String?   @map("workflow_instance_id") @db.Char(36)
  computedAt          DateTime? @map("computed_at") @db.DateTime(3)
  submittedAt         DateTime? @map("submitted_at") @db.DateTime(3)
  approvedAt          DateTime? @map("approved_at") @db.DateTime(3)
  finalizedAt         DateTime? @map("finalized_at") @db.DateTime(3)
  finalizedByUserId   String?   @map("finalized_by_user_id") @db.Char(36)
  reopenedAt          DateTime? @map("reopened_at") @db.DateTime(3)
  reopenReason        String?   @map("reopen_reason") @db.VarChar(500)
  reopenedByUserId    String?   @map("reopened_by_user_id") @db.Char(36)
  payslipsPublishedAt DateTime? @map("payslips_published_at") @db.DateTime(3)
  createdByUserId     String?   @map("created_by_user_id") @db.Char(36)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batch        PayrollBatch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  employees    PayrollRunEmployee[]
  items        PayrollItem[]

  @@index([organizationId, institutionId, periodStart, status])
  @@index([organizationId, batchId])
  @@map("payroll_runs")
}

/// One employee's computation within a run (attendance snapshot, totals, calc trace).
model PayrollRunEmployee {
  id                    String   @id @default(uuid()) @db.Char(36)
  organizationId        String   @map("organization_id") @db.Char(36)
  runId                 String   @map("run_id") @db.Char(36)
  employeeId            String   @map("employee_id") @db.Char(36)
  institutionId         String   @map("institution_id") @db.Char(36)
  departmentId          String?  @map("department_id") @db.Char(36)
  employeeCode          String   @map("employee_code") @db.VarChar(64)
  employeeName          String   @map("employee_name") @db.VarChar(200)
  status                String   @default("OK") @db.VarChar(16)
  error                 String?  @db.Text
  calendarDays          Decimal  @default(0) @map("calendar_days") @db.Decimal(6, 2)
  payableDays           Decimal  @default(0) @map("payable_days") @db.Decimal(6, 2)
  lopDays               Decimal  @default(0) @map("lop_days") @db.Decimal(6, 2)
  institutionDays       Decimal  @default(0) @map("institution_days") @db.Decimal(6, 2)
  factor                Decimal  @default(0) @db.Decimal(10, 6)
  gross                 Decimal  @default(0) @db.Decimal(14, 2)
  deductions            Decimal  @default(0) @db.Decimal(14, 2)
  net                   Decimal  @default(0) @db.Decimal(14, 2)
  employerContributions Decimal  @default(0) @map("employer_contributions") @db.Decimal(14, 2)
  salaryHistoryId       String?  @map("salary_history_id") @db.Char(36)
  structureVersionId    String?  @map("structure_version_id") @db.Char(36)
  trace                 Json
  warnings              Json
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          PayrollRun   @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([organizationId, employeeId])
  @@map("payroll_run_employees")
}

/// Per-employee, per-component result line of a run.
model PayrollItem {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  runId          String   @map("run_id") @db.Char(36)
  runEmployeeId  String   @map("run_employee_id") @db.Char(36)
  employeeId     String   @map("employee_id") @db.Char(36)
  code           String   @db.VarChar(32)
  name           String   @db.VarChar(300)
  type           String   @db.VarChar(32)
  category       String   @db.VarChar(32)
  statutoryCode  String?  @map("statutory_code") @db.VarChar(16)
  amount         Decimal  @db.Decimal(14, 2)
  fullAmount     Decimal  @map("full_amount") @db.Decimal(14, 2)
  taxable        Boolean  @default(true)
  showOnPayslip  Boolean  @default(true) @map("show_on_payslip")
  displayOrder   Int      @default(100) @map("display_order")
  explanation    String   @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  run          PayrollRun   @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([organizationId, runId, employeeId])
  @@index([organizationId, runId, code])
  @@map("payroll_items")
}

/// One-time adjustment. `runId` null = pending (claimed by the next run of the institution).
model PayrollAdjustment {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  runId           String?  @map("run_id") @db.Char(36)
  employeeId      String   @map("employee_id") @db.Char(36)
  institutionId   String   @map("institution_id") @db.Char(36)
  type            String   @db.VarChar(24)
  code            String   @db.VarChar(32)
  amount          Decimal  @db.Decimal(14, 2)
  taxable         Boolean  @default(true)
  description     String   @db.VarChar(300)
  source          String   @default("manual") @db.VarChar(32)
  sourceId        String?  @map("source_id") @db.Char(36)
  status          String   @default("PENDING") @db.VarChar(16)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, institutionId, status])
  @@index([organizationId, runId])
  @@index([organizationId, employeeId])
  @@map("payroll_adjustments")
}

/// Net-pay disbursement per employee of a finalized run.
model PayrollPayment {
  id                String    @id @default(uuid()) @db.Char(36)
  organizationId    String    @map("organization_id") @db.Char(36)
  runId             String    @map("run_id") @db.Char(36)
  employeeId        String    @map("employee_id") @db.Char(36)
  amount            Decimal   @db.Decimal(14, 2)
  method            String    @default("BANK_TRANSFER") @db.VarChar(24)
  status            String    @default("PENDING") @db.VarChar(16)
  bankAccountMasked String?   @map("bank_account_masked") @db.VarChar(32)
  reference         String?   @db.VarChar(120)
  paidAt            DateTime? @map("paid_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([organizationId, runId, status])
  @@map("payroll_payments")
}

/// Published payslip (PDF stored as an employee document, category `payroll`).
model Payslip {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  runId          String   @map("run_id") @db.Char(36)
  employeeId     String   @map("employee_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  revision       Int      @default(1)
  documentId     String?  @map("document_id") @db.Char(36)
  net            Decimal  @db.Decimal(14, 2)
  status         String   @default("PUBLISHED") @db.VarChar(16)
  publishedAt    DateTime @default(now()) @map("published_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([organizationId, employeeId, periodStart])
  @@map("payslips")
}

/// Form 16 per employee per financial year (PDF via the document engine; acceptance 18).
model Form16Record {
  id                String    @id @default(uuid()) @db.Char(36)
  organizationId    String    @map("organization_id") @db.Char(36)
  employeeId        String    @map("employee_id") @db.Char(36)
  institutionId     String    @map("institution_id") @db.Char(36)
  financialYear     String    @map("financial_year") @db.VarChar(7)
  documentId        String    @map("document_id") @db.Char(36)
  status            String    @default("DRAFT") @db.VarChar(16)
  publishedAt       DateTime? @map("published_at") @db.DateTime(3)
  publishedByUserId String?   @map("published_by_user_id") @db.Char(36)
  uploadedByUserId  String?   @map("uploaded_by_user_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, financialYear])
  @@map("form16_records")
}

/// Employee loan / salary advance; EMIs are auto-deducted by payroll runs.
model Loan {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @map("organization_id") @db.Char(36)
  employeeId      String   @map("employee_id") @db.Char(36)
  institutionId   String   @map("institution_id") @db.Char(36)
  loanType        String   @map("loan_type") @db.VarChar(64)
  principal       Decimal  @db.Decimal(14, 2)
  emiAmount       Decimal  @map("emi_amount") @db.Decimal(14, 2)
  outstanding     Decimal  @db.Decimal(14, 2)
  startMonth      DateTime @map("start_month") @db.Date
  tenureMonths    Int      @map("tenure_months")
  status          String   @default("ACTIVE") @db.VarChar(16)
  reason          String?  @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  installments LoanInstallment[]

  @@index([organizationId, employeeId, status])
  @@map("loans")
}

model LoanInstallment {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  loanId         String   @map("loan_id") @db.Char(36)
  employeeId     String   @map("employee_id") @db.Char(36)
  dueMonth       DateTime @map("due_month") @db.Date
  amount         Decimal  @db.Decimal(14, 2)
  status         String   @default("DUE") @db.VarChar(16)
  runId          String?  @map("run_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  loan         Loan         @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@unique([loanId, dueMonth])
  @@index([organizationId, employeeId, dueMonth, status])
  @@map("loan_installments")
}

/// Reimbursement claim approved via workflow `reimbursement_claim` → payroll adjustment.
model ReimbursementClaim {
  id                 String    @id @default(uuid()) @db.Char(36)
  organizationId     String    @map("organization_id") @db.Char(36)
  employeeId         String    @map("employee_id") @db.Char(36)
  institutionId      String    @map("institution_id") @db.Char(36)
  groupId            String?   @map("group_id") @db.Char(36)
  category           String    @db.VarChar(64)
  amount             Decimal   @db.Decimal(14, 2)
  claimDate          DateTime  @map("claim_date") @db.Date
  description        String    @db.VarChar(500)
  taxable            Boolean   @default(false)
  status             String    @default("PENDING_APPROVAL") @db.VarChar(24)
  workflowInstanceId String?   @map("workflow_instance_id") @db.Char(36)
  adjustmentId       String?   @map("adjustment_id") @db.Char(36)
  decidedComment     String?   @map("decided_comment") @db.VarChar(1000)
  requestedByUserId  String?   @map("requested_by_user_id") @db.Char(36)
  decidedAt          DateTime? @map("decided_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, status])
  @@map("reimbursement_claims")
}

// ===== AI =====

/// Per-organization AI gateway settings (provider, model, enabled AI features, data sharing).
model AiSetting {
  id                  String   @id @default(uuid()) @db.Char(36)
  organizationId      String   @map("organization_id") @db.Char(36)
  enabled             Boolean  @default(true)
  provider            String   @default("mock") @db.VarChar(16)
  defaultModel        String   @default("gpt-4o-mini") @map("default_model") @db.VarChar(100)
  maxTokensPerRequest Int      @default(1024) @map("max_tokens_per_request")
  temperature         Decimal  @default(0.2) @db.Decimal(3, 2)
  enabledFeatures     Json     @map("enabled_features")
  dataSharing         Boolean  @default(false) @map("data_sharing")
  updatedByUserId     String?  @map("updated_by_user_id") @db.Char(36)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId])
  @@map("ai_settings")
}

/// A user's private AI conversation (assistant chat). Soft-deleted by its owner.
model AiConversation {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  feature        String    @db.VarChar(32)
  title          String    @db.VarChar(200)
  messageCount   Int       @default(0) @map("message_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  messages     AiMessage[]

  @@index([organizationId, userId, deletedAt, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  conversationId String   @map("conversation_id") @db.Char(36)
  role           String   @db.VarChar(16)
  content        String   @db.Text
  toolCalls      Json?    @map("tool_calls")
  totalTokens    Int      @default(0) @map("total_tokens")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  @@index([organizationId, conversationId, createdAt])
  @@map("ai_messages")
}

/// One row per AI gateway call. Prompts are stored REDACTED + truncated; never secrets.
model AiUsageLog {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  userId           String?  @map("user_id") @db.Char(36)
  feature          String   @db.VarChar(32)
  provider         String   @db.VarChar(16)
  model            String   @db.VarChar(100)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")
  status           String   @db.VarChar(16)
  errorCode        String?  @map("error_code") @db.VarChar(64)
  promptRedacted   String?  @map("prompt_redacted") @db.VarChar(1000)
  conversationId   String?  @map("conversation_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, feature, createdAt])
  @@index([organizationId, userId, createdAt])
  @@map("ai_usage_logs")
}

// ===== Library =====

/// Catalogue title (book, journal, magazine, e-resource) held by an institution library.
model LibraryBook {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  groupId         String?   @map("group_id") @db.Char(36)
  institutionId   String    @map("institution_id") @db.Char(36)
  campusId        String?   @map("campus_id") @db.Char(36)
  itemType        String    @default("BOOK") @map("item_type") @db.VarChar(16)
  isbn            String?   @db.VarChar(20)
  title           String    @db.VarChar(300)
  subtitle        String?   @db.VarChar(300)
  authors         Json?
  /// Authors joined with "; " for search.
  authorText      String?   @map("author_text") @db.VarChar(1000)
  publisher       String?   @db.VarChar(200)
  edition         String?   @db.VarChar(60)
  publicationYear Int?      @map("publication_year")
  category        String?   @db.VarChar(100)
  language        String?   @db.VarChar(40)
  tags            Json?
  callNumber      String?   @map("call_number") @db.VarChar(60)
  url             String?   @db.VarChar(500)
  description     String?   @db.VarChar(2000)
  coverDocumentId String?   @map("cover_document_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  copies       LibraryCopy[]
  loans        LibraryLoan[]
  reservations LibraryReservation[]

  @@index([organizationId, institutionId, title])
  @@index([organizationId, isbn])
  @@index([organizationId, category])
  @@index([organizationId, deletedAt])
  @@map("library_books")
}

/// Physical copy (accession) of a catalogue title, identified by barcode.
model LibraryCopy {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  campusId       String?   @map("campus_id") @db.Char(36)
  bookId         String    @map("book_id") @db.Char(36)
  accessionNo    String    @map("accession_no") @db.VarChar(40)
  barcode        String    @db.VarChar(64)
  shelf          String?   @db.VarChar(40)
  rack           String?   @db.VarChar(40)
  status         String    @default("AVAILABLE") @db.VarChar(16)
  condition      String?   @db.VarChar(40)
  price          Decimal?  @db.Decimal(12, 2)
  acquiredOn     DateTime? @map("acquired_on") @db.Date
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  book         LibraryBook          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  loans        LibraryLoan[]
  reservations LibraryReservation[]

  @@unique([organizationId, barcode])
  @@unique([organizationId, institutionId, accessionNo])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, bookId, status])
  @@map("library_copies")
}

/// Membership policy per institution library and member type (STUDENT / EMPLOYEE).
model LibraryPolicy {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  groupId        String?  @map("group_id") @db.Char(36)
  institutionId  String   @map("institution_id") @db.Char(36)
  campusId       String?  @map("campus_id") @db.Char(36)
  memberType     String   @map("member_type") @db.VarChar(16)
  maxBooks       Int      @default(3) @map("max_books")
  loanDays       Int      @default(14) @map("loan_days")
  maxRenewals    Int      @default(1) @map("max_renewals")
  finePerDay     Decimal  @default(1) @map("fine_per_day") @db.Decimal(10, 2)
  maxFine        Decimal  @default(100) @map("max_fine") @db.Decimal(12, 2)
  holdDays       Int      @default(3) @map("hold_days")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, institutionId, memberType])
  @@map("library_policies")
}

/// Circulation record: one copy issued to one member (student or employee).
model LibraryLoan {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  groupId          String?   @map("group_id") @db.Char(36)
  institutionId    String    @map("institution_id") @db.Char(36)
  campusId         String?   @map("campus_id") @db.Char(36)
  copyId           String    @map("copy_id") @db.Char(36)
  bookId           String    @map("book_id") @db.Char(36)
  memberType       String    @map("member_type") @db.VarChar(16)
  studentId        String?   @map("student_id") @db.Char(36)
  employeeId       String?   @map("employee_id") @db.Char(36)
  memberUserId     String?   @map("member_user_id") @db.Char(36)
  memberName       String    @map("member_name") @db.VarChar(200)
  issuedAt         DateTime  @map("issued_at") @db.DateTime(3)
  dueDate          DateTime  @map("due_date") @db.Date
  returnedAt       DateTime? @map("returned_at") @db.DateTime(3)
  renewCount       Int       @default(0) @map("renew_count")
  status           String    @default("ISSUED") @db.VarChar(16)
  fineAmount       Decimal   @default(0) @map("fine_amount") @db.Decimal(12, 2)
  returnCondition  String?   @map("return_condition") @db.VarChar(16)
  reminderCount    Int       @default(0) @map("reminder_count")
  lastReminderAt   DateTime? @map("last_reminder_at") @db.DateTime(3)
  issuedByUserId   String?   @map("issued_by_user_id") @db.Char(36)
  returnedByUserId String?   @map("returned_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  copy         LibraryCopy   @relation(fields: [copyId], references: [id], onDelete: Restrict)
  book         LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  fines        LibraryFine[]

  @@index([organizationId, institutionId, status, dueDate])
  @@index([organizationId, copyId, status])
  @@index([organizationId, bookId])
  @@index([organizationId, studentId, status])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, memberUserId])
  @@map("library_loans")
}

/// Hold queue entry for a title; READY holds a specific copy until expiresAt.
model LibraryReservation {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String    @map("institution_id") @db.Char(36)
  campusId       String?   @map("campus_id") @db.Char(36)
  bookId         String    @map("book_id") @db.Char(36)
  copyId         String?   @map("copy_id") @db.Char(36)
  memberType     String    @map("member_type") @db.VarChar(16)
  studentId      String?   @map("student_id") @db.Char(36)
  employeeId     String?   @map("employee_id") @db.Char(36)
  memberUserId   String?   @map("member_user_id") @db.Char(36)
  memberName     String    @map("member_name") @db.VarChar(200)
  status         String    @default("WAITING") @db.VarChar(16)
  readyAt        DateTime? @map("ready_at") @db.DateTime(3)
  expiresAt      DateTime? @map("expires_at") @db.DateTime(3)
  closedAt       DateTime? @map("closed_at") @db.DateTime(3)
  loanId         String?   @map("loan_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  book         LibraryBook  @relation(fields: [bookId], references: [id], onDelete: Restrict)
  copy         LibraryCopy? @relation(fields: [copyId], references: [id], onDelete: Restrict)

  @@index([organizationId, bookId, status, createdAt])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, studentId, status])
  @@index([organizationId, employeeId, status])
  @@map("library_reservations")
}

/// Library fine (overdue/lost/damaged). POSTED = handed to the fee module via the fine poster hook.
model LibraryFine {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  groupId          String?   @map("group_id") @db.Char(36)
  institutionId    String    @map("institution_id") @db.Char(36)
  campusId         String?   @map("campus_id") @db.Char(36)
  loanId           String?   @map("loan_id") @db.Char(36)
  memberType       String    @map("member_type") @db.VarChar(16)
  studentId        String?   @map("student_id") @db.Char(36)
  employeeId       String?   @map("employee_id") @db.Char(36)
  memberUserId     String?   @map("member_user_id") @db.Char(36)
  memberName       String    @map("member_name") @db.VarChar(200)
  amount           Decimal   @db.Decimal(12, 2)
  reason           String    @db.VarChar(16)
  status           String    @default("PENDING") @db.VarChar(16)
  note             String?   @db.VarChar(500)
  externalChargeId String?   @map("external_charge_id") @db.VarChar(64)
  settledAt        DateTime? @map("settled_at") @db.DateTime(3)
  settledByUserId  String?   @map("settled_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  loan         LibraryLoan? @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@index([organizationId, institutionId, status])
  @@index([organizationId, studentId, status])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, loanId])
  @@map("library_fines")
}

/// Stock verification session: scanned barcodes compared against expected shelf stock.
model LibraryStockVerification {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @map("organization_id") @db.Char(36)
  groupId         String?   @map("group_id") @db.Char(36)
  institutionId   String    @map("institution_id") @db.Char(36)
  campusId        String?   @map("campus_id") @db.Char(36)
  name            String    @db.VarChar(200)
  status          String    @default("OPEN") @db.VarChar(16)
  scannedBarcodes Json?     @map("scanned_barcodes")
  result          Json?
  startedByUserId String?   @map("started_by_user_id") @db.Char(36)
  completedAt     DateTime? @map("completed_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([organizationId, institutionId, status])
  @@map("library_stock_verifications")
}

// ===== Assets =====
// Asset management (feature `assets`): categories with depreciation + tag series, the asset
// register, custody assignments, transfers, maintenance, disposal, physical audits and a light
// consumables inventory. Child tables copy the asset's hierarchy columns for scope filtering.
// ============================================================================================

enum AssetDepreciationMethod {
  NONE
  SLM
  WDV
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  UNDER_REPAIR
  LOST
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetAssignmentTarget {
  EMPLOYEE
  DEPARTMENT
  LOCATION
}

enum AssetAssignmentStatus {
  ACTIVE
  RETURNED
}

enum AssetReturnStatus {
  RETURNED
  DAMAGED
  MISSING
}

enum AssetTransferStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  CANCELLED
}

enum AssetMaintenanceType {
  REPAIR
  PREVENTIVE
  AMC_VISIT
  WARRANTY_CLAIM
  INSPECTION
}

enum AssetMaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssetMaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetDisposalMethod {
  SOLD
  SCRAPPED
  DONATED
  WRITTEN_OFF
  LOST
}

enum AssetDisposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum AssetAuditStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum AssetAuditResult {
  PENDING
  VERIFIED
  MISSING
  LOCATION_MISMATCH
  CONDITION_MISMATCH
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUST
}

model AssetCategory {
  id                 String                  @id @default(uuid()) @db.Char(36)
  organizationId     String                  @map("organization_id") @db.Char(36)
  groupId            String?                 @map("group_id") @db.Char(36)
  institutionId      String?                 @map("institution_id") @db.Char(36)
  code               String                  @db.VarChar(32)
  name               String                  @db.VarChar(120)
  kind               String                  @db.VarChar(32)
  description        String?                 @db.VarChar(1000)
  attributes         Json?
  depreciationMethod AssetDepreciationMethod @default(SLM) @map("depreciation_method")
  depreciationRate   Decimal?                @map("depreciation_rate") @db.Decimal(6, 2)
  usefulLifeYears    Int?                    @map("useful_life_years")
  residualPercent    Decimal                 @default(5) @map("residual_percent") @db.Decimal(5, 2)
  tagPrefix          String                  @map("tag_prefix") @db.VarChar(24)
  tagPadding         Int                     @default(5) @map("tag_padding")
  tagNextNumber      Int                     @default(1) @map("tag_next_number")
  createdAt          DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime?               @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  assets       Asset[]

  @@unique([organizationId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, kind])
  @@index([organizationId, deletedAt])
  @@map("asset_categories")
}

model Asset {
  id                  String         @id @default(uuid()) @db.Char(36)
  organizationId      String         @map("organization_id") @db.Char(36)
  groupId             String?        @map("group_id") @db.Char(36)
  institutionId       String         @map("institution_id") @db.Char(36)
  campusId            String?        @map("campus_id") @db.Char(36)
  departmentId        String?        @map("department_id") @db.Char(36)
  categoryId          String         @map("category_id") @db.Char(36)
  assetTag            String         @map("asset_tag") @db.VarChar(40)
  name                String         @db.VarChar(200)
  make                String?        @db.VarChar(120)
  model               String?        @db.VarChar(120)
  serialNo            String?        @map("serial_no") @db.VarChar(120)
  attributes          Json?
  vendor              String?        @db.VarChar(200)
  invoiceNo           String?        @map("invoice_no") @db.VarChar(80)
  purchaseDate        DateTime?      @map("purchase_date") @db.Date
  purchaseCost        Decimal        @default(0) @map("purchase_cost") @db.Decimal(14, 2)
  warrantyExpiry      DateTime?      @map("warranty_expiry") @db.Date
  invoiceDocumentId   String?        @map("invoice_document_id") @db.Char(36)
  amcVendor           String?        @map("amc_vendor") @db.VarChar(200)
  amcExpiry           DateTime?      @map("amc_expiry") @db.Date
  serviceIntervalDays Int?           @map("service_interval_days")
  nextServiceDate     DateTime?      @map("next_service_date") @db.Date
  location            String?        @db.VarChar(200)
  condition           AssetCondition @default(GOOD)
  status              AssetStatus    @default(IN_STOCK)
  custodianEmployeeId String?        @map("custodian_employee_id") @db.Char(36)
  lastVerifiedAt      DateTime?      @map("last_verified_at") @db.DateTime(3)
  disposedAt          DateTime?      @map("disposed_at") @db.Date
  notes               String?        @db.VarChar(2000)
  createdAt           DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime?      @map("deleted_at") @db.DateTime(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus       Campus?            @relation(fields: [campusId], references: [id], onDelete: Restrict)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  category     AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  custodian    Employee?          @relation(fields: [custodianEmployeeId], references: [id], onDelete: Restrict)
  assignments  AssetAssignment[]
  transfers    AssetTransfer[]
  maintenance  AssetMaintenance[]
  disposals    AssetDisposal[]
  auditItems   AssetAuditItem[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, groupId])
  @@index([organizationId, departmentId])
  @@index([organizationId, categoryId])
  @@index([organizationId, custodianEmployeeId])
  @@index([organizationId, serialNo])
  @@index([organizationId, warrantyExpiry])
  @@index([organizationId, deletedAt])
  @@map("assets")
}

model AssetAssignment {
  id                   String                @id @default(uuid()) @db.Char(36)
  organizationId       String                @map("organization_id") @db.Char(36)
  assetId              String                @map("asset_id") @db.Char(36)
  groupId              String?               @map("group_id") @db.Char(36)
  institutionId        String                @map("institution_id") @db.Char(36)
  campusId             String?               @map("campus_id") @db.Char(36)
  departmentId         String?               @map("department_id") @db.Char(36)
  targetType           AssetAssignmentTarget @default(EMPLOYEE) @map("target_type")
  employeeId           String?               @map("employee_id") @db.Char(36)
  assignedDepartmentId String?               @map("assigned_department_id") @db.Char(36)
  location             String?               @db.VarChar(200)
  assignedAt           DateTime              @map("assigned_at") @db.Date
  expectedReturnDate   DateTime?             @map("expected_return_date") @db.Date
  accessories          Json?
  conditionOut         AssetCondition        @default(GOOD) @map("condition_out")
  notes                String?               @db.VarChar(1000)
  status               AssetAssignmentStatus @default(ACTIVE)
  acknowledgedAt       DateTime?             @map("acknowledged_at") @db.DateTime(3)
  acknowledgedByUserId String?               @map("acknowledged_by_user_id") @db.Char(36)
  acknowledgementNote  String?               @map("acknowledgement_note") @db.VarChar(1000)
  handoverDocumentId   String?               @map("handover_document_id") @db.Char(36)
  assignedByUserId     String?               @map("assigned_by_user_id") @db.Char(36)
  returnedAt           DateTime?             @map("returned_at") @db.Date
  returnStatus         AssetReturnStatus?    @map("return_status")
  conditionIn          AssetCondition?       @map("condition_in")
  recoveryAmount       Decimal?              @map("recovery_amount") @db.Decimal(14, 2)
  returnNotes          String?               @map("return_notes") @db.VarChar(1000)
  returnedByUserId     String?               @map("returned_by_user_id") @db.Char(36)
  createdAt            DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, assetId, status])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, institutionId, status])
  @@index([organizationId, status, assignedAt])
  @@map("asset_assignments")
}

model AssetTransfer {
