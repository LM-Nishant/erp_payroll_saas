// Education ERP — Prisma schema (MySQL 8)
//
// Conventions (binding for all layers, see docs/ARCHITECTURE.md):
//  * Primary keys are UUID v4 strings stored as CHAR(36).
//  * Every tenant-owned table carries `organization_id` (the tenant id) plus the
//    hierarchy FKs relevant to it, and is indexed on (organization_id, ...).
//  * All tables have created_at / updated_at; business tables are soft-deleted via deleted_at.
//  * Table & column names are snake_case (@@map / @map); Prisma fields are camelCase.
//  * Any new tenant-owned model MUST be registered in src/core/tenancy/tenant-models.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  INSTITUTE
}

enum ProgramLevel {
  PRE_PRIMARY
  PRIMARY
  SECONDARY
  HIGHER_SECONDARY
  DIPLOMA
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  CERTIFICATE
  OTHER
}

/// Platform tenant root. One organization = one SaaS customer (an education group,
/// an education society, or an independent institution). Not tenant-scoped itself.
model Organization {
  id        String             @id @default(uuid()) @db.Char(36)
  name      String             @db.VarChar(200)
  slug      String             @unique @db.VarChar(64)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime?          @map("deleted_at") @db.DateTime(3)

  groups           Group[]
  institutions     Institution[]
  campuses         Campus[]
  departments      Department[]
  programs         Program[]
  classSections    ClassSection[]
  memberships      OrganizationMembership[]
  roles            Role[]
  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  userScopes       UserScope[]
  authSessions     AuthSession[]
  loginEvents      LoginEvent[]
  userTokens       UserToken[]
  auditLogs        AuditLog[]
  subscription     OrganizationSubscription?
  invoices         Invoice[]
  featureOverrides FeatureOverride[]
  usageCounters    UsageCounter[]
  brandingProfiles BrandingProfile[]
  secrets          TenantSecret[]

  @@map("organizations")
}

/// Education group (e.g. "ABBS Group") owning multiple institutions.
model Group {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  description    String?      @db.VarChar(1000)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institutions     Institution[]
  userScopes       UserScope[]
  featureOverrides FeatureOverride[]
  brandingProfiles BrandingProfile[]
  secrets          TenantSecret[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("groups")
}

/// School / college / university. `groupId` is null for independent institutions.
model Institution {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @map("organization_id") @db.Char(36)
  groupId        String?         @map("group_id") @db.Char(36)
  name           String          @db.VarChar(200)
  code           String          @db.VarChar(32)
  type           InstitutionType @default(COLLEGE)
  status         EntityStatus    @default(ACTIVE)
  email          String?         @db.VarChar(200)
  phone          String?         @db.VarChar(32)
  address        String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?       @map("deleted_at") @db.DateTime(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group            Group?            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  campuses         Campus[]
  departments      Department[]
  programs         Program[]
  classSections    ClassSection[]
  userScopes       UserScope[]
  featureOverrides FeatureOverride[]
  brandingProfiles BrandingProfile[]
  secrets          TenantSecret[]

  @@unique([organizationId, code])
  @@index([organizationId, groupId])
  @@index([organizationId, deletedAt])
  @@index([groupId])
  @@map("institutions")
}

model Campus {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  address        String?      @db.VarChar(500)
  isMain         Boolean      @default(false) @map("is_main")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  departments   Department[]
  classSections ClassSection[]
  userScopes    UserScope[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, deletedAt])
  @@map("campuses")
}

model Department {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  campusId       String?      @map("campus_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  description    String?      @db.VarChar(1000)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus        Campus?        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  programs      Program[]
  classSections ClassSection[]
  userScopes    UserScope[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, campusId])
  @@index([organizationId, deletedAt])
  @@map("departments")
}

/// Program / course offered by a department (e.g. B.Sc Computer Science, Grade 10).
model Program {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  departmentId   String       @map("department_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  level          ProgramLevel @default(UNDERGRADUATE)
  durationMonths Int?         @map("duration_months")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  classSections ClassSection[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@index([organizationId, deletedAt])
  @@map("programs")
}

/// Class / section / batch within a program (e.g. "BSc CS 2025 - Section A").
model ClassSection {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  institutionId  String       @map("institution_id") @db.Char(36)
  departmentId   String       @map("department_id") @db.Char(36)
  programId      String       @map("program_id") @db.Char(36)
  campusId       String?      @map("campus_id") @db.Char(36)
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(32)
  academicYear   String?      @map("academic_year") @db.VarChar(9)
  capacity       Int?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@unique([programId, code, academicYear])
  @@index([organizationId, institutionId])
  @@index([organizationId, departmentId])
  @@index([organizationId, programId])
  @@index([organizationId, campusId])
  @@index([organizationId, deletedAt])
  @@map("class_sections")
}

// ---------------------------------------------------------------------------
// Layer 2 — Identity, authentication, authorization (RBAC + scopes) and audit
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Breadth of a role assignment. PLATFORM roles are not stored here (see PlatformRoleAssignment).
enum ScopeType {
  ORGANIZATION
  GROUP
  INSTITUTION
  CAMPUS
  DEPARTMENT
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
}

/// Platform-level identity (GLOBAL). A user joins tenants through OrganizationMembership.
/// Only core/auth touches this table; modules use the identity service.
model User {
  id                  String     @id @default(uuid()) @db.Char(36)
  email               String     @unique @db.VarChar(254)
  name                String     @db.VarChar(200)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  status              UserStatus @default(ACTIVE)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  /// TOTP secret, AES-256-GCM encrypted (core/crypto). Never returned by the API.
  mfaSecretEnc        String?    @map("mfa_secret_enc") @db.VarChar(512)
  mfaPendingSecretEnc String?    @map("mfa_pending_secret_enc") @db.VarChar(512)
  /// Last accepted TOTP time-step (replay protection).
  mfaLastUsedStep     Int?       @map("mfa_last_used_step")
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until") @db.DateTime(3)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.DateTime(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime?  @map("deleted_at") @db.DateTime(3)

  memberships   OrganizationMembership[]
  platformRoles PlatformRoleAssignment[]
  userRoles     UserRole[]
  userScopes    UserScope[]
  sessions      AuthSession[]
  loginEvents   LoginEvent[]
  recoveryCodes MfaRecoveryCode[]
  tokens        UserToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

/// Platform roles (platform_super_admin, platform_support_admin). Permissions come from the
/// code catalog (core/authz/default-roles.ts). GLOBAL; managed by core only.
model PlatformRoleAssignment {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleKey   String   @map("role_key") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, roleKey])
  @@map("platform_role_assignments")
}

/// A user's membership of a tenant.
model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  userId         String           @map("user_id") @db.Char(36)
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?        @map("joined_at") @db.DateTime(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?        @map("deleted_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_memberships")
}

/// Permission catalog (GLOBAL), synced from @erp/shared PERMISSIONS.
model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(64)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Tenant role. System roles (isSystem) are provisioned per organization from the defaults.
model Role {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  key            String    @db.VarChar(64)
  name           String    @db.VarChar(200)
  description    String?   @db.VarChar(1000)
  isSystem       Boolean   @default(false) @map("is_system")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, key])
  @@index([organizationId, deletedAt])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  roleId         String   @map("role_id") @db.Char(36)
  permissionId   String   @map("permission_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([organizationId, roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Assignment of a role to a user. Effective only within the assignment's UserScopes.
model UserRole {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  roleId         String   @map("role_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopes       UserScope[]

  @@unique([organizationId, userId, roleId])
  @@index([organizationId, userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Where a role assignment applies. `scopeType` decides which FK is the scope target; the other
/// hierarchy FKs are denormalized ancestors (e.g. a DEPARTMENT scope also stores its institution
/// and group) so "users within my scope" filters stay simple.
model UserScope {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  userRoleId     String    @map("user_role_id") @db.Char(36)
  scopeType      ScopeType @map("scope_type")
  groupId        String?   @map("group_id") @db.Char(36)
  institutionId  String?   @map("institution_id") @db.Char(36)
  campusId       String?   @map("campus_id") @db.Char(36)
  departmentId   String?   @map("department_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  userRole     UserRole     @relation(fields: [userRoleId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId])
  @@index([organizationId, userRoleId])
  @@index([organizationId, institutionId])
  @@index([organizationId, groupId])
  @@map("user_scopes")
}

/// Device/login session (CORE-MANAGED). organizationId is the tenant the session is bound to;
/// null for platform-only sessions.
model AuthSession {
  id                   String    @id @default(uuid()) @db.Char(36)
  userId               String    @map("user_id") @db.Char(36)
  organizationId       String?   @map("organization_id") @db.Char(36)
  ip                   String?   @db.VarChar(64)
  userAgent            String?   @map("user_agent") @db.VarChar(512)
  deviceName           String?   @map("device_name") @db.VarChar(100)
  mfaVerified          Boolean   @default(false) @map("mfa_verified")
  /// Set for audited platform cross-tenant access sessions.
  platformAccessReason String?   @map("platform_access_reason") @db.VarChar(500)
  expiresAt            DateTime  @map("expires_at") @db.DateTime(3)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.DateTime(3)
  revokedAt            DateTime? @map("revoked_at") @db.DateTime(3)
  revokedReason        String?   @map("revoked_reason") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([organizationId, userId])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Rotating refresh tokens; only a SHA-256 hash is stored. GLOBAL (child of AuthSession).
model RefreshToken {
  id        String             @id @default(uuid()) @db.Char(36)
  sessionId String             @map("session_id") @db.Char(36)
  tokenHash String             @unique @map("token_hash") @db.Char(64)
  status    RefreshTokenStatus @default(ACTIVE)
  expiresAt DateTime           @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?          @map("used_at") @db.DateTime(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, status])
  @@map("refresh_tokens")
}

/// Login history (CORE-MANAGED). Append-only.
model LoginEvent {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String?  @map("organization_id") @db.Char(36)
  userId         String?  @map("user_id") @db.Char(36)
  email          String   @db.VarChar(254)
  success        Boolean
  failureReason  String?  @map("failure_reason") @db.VarChar(64)
  mfaUsed        Boolean  @default(false) @map("mfa_used")
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("login_events")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// One-time invite / password-reset tokens (CORE-MANAGED); only a SHA-256 hash is stored.
model UserToken {
  id             String        @id @default(uuid()) @db.Char(36)
  userId         String        @map("user_id") @db.Char(36)
  organizationId String?       @map("organization_id") @db.Char(36)
  type           UserTokenType
  tokenHash      String        @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime      @map("expires_at") @db.DateTime(3)
  usedAt         DateTime?     @map("used_at") @db.DateTime(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, type])
  @@index([organizationId, type])
  @@map("user_tokens")
}

/// Audit trail (CORE-MANAGED, APPEND-ONLY: database triggers reject UPDATE and DELETE).
/// organizationId is null only for platform-level events.
model AuditLog {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String?  @map("organization_id") @db.Char(36)
  actorUserId    String?  @map("actor_user_id") @db.Char(36)
  /// user | platform | system | dev
  actorType      String   @map("actor_type") @db.VarChar(16)
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  before         Json?
  after          Json?
  reason         String?  @db.VarChar(500)
  metadata       Json?
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId, createdAt])
  @@index([organizationId, action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// Subscription / module licensing (spec §63, §64), branding (§65.5), secrets (§44, §62)
// ---------------------------------------------------------------------------------------------

/// Hierarchy level a setting (feature override, branding, secret) is attached to.
enum SettingScopeType {
  ORGANIZATION
  GROUP
  INSTITUTION
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
}

/// Platform-managed plan catalog (GLOBAL — not tenant data).
model SubscriptionPlan {
  id              String          @id @default(uuid()) @db.Char(36)
  key             String          @unique @db.VarChar(64)
  name            String          @db.VarChar(200)
  description     String?         @db.VarChar(1000)
  status          PlanStatus      @default(ACTIVE)
  priceCents      Int             @default(0) @map("price_cents")
  currency        String          @default("INR") @db.Char(3)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  trialDays       Int             @default(14) @map("trial_days")
  /// FeatureKey[]
  features        Json
  /// PlanLimits — `null` value = unlimited, missing key = 0.
  limits          Json
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  subscriptions OrganizationSubscription[]

  @@map("subscription_plans")
}

/// One subscription per organization.
model OrganizationSubscription {
  id                 String             @id @default(uuid()) @db.Char(36)
  organizationId     String             @unique @map("organization_id") @db.Char(36)
  planId             String             @map("plan_id") @db.Char(36)
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.DateTime(3)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.DateTime(3)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.DateTime(3)
  cancelledAt        DateTime?          @map("cancelled_at") @db.DateTime(3)
  /// FeatureKey[] licensed on top of the plan.
  addOnFeatures      Json               @map("add_on_features")
  /// PlanLimits merged over the plan limits.
  limitOverrides     Json               @map("limit_overrides")
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([planId])
  @@map("organization_subscriptions")
}

/// Subscription invoice. No payment gateway yet — `status` doubles as the payment status.
model Invoice {
  id               String        @id @default(uuid()) @db.Char(36)
  organizationId   String        @map("organization_id") @db.Char(36)
  subscriptionId   String        @map("subscription_id") @db.Char(36)
  number           String        @unique @db.VarChar(40)
  periodStart      DateTime      @map("period_start") @db.DateTime(3)
  periodEnd        DateTime      @map("period_end") @db.DateTime(3)
  amountCents      Int           @map("amount_cents")
  currency         String        @db.Char(3)
  status           InvoiceStatus @default(OPEN)
  issuedAt         DateTime?     @map("issued_at") @db.DateTime(3)
  dueAt            DateTime      @map("due_at") @db.DateTime(3)
  paidAt           DateTime?     @map("paid_at") @db.DateTime(3)
  paymentMethod    String?       @map("payment_method") @db.VarChar(64)
  paymentReference String?       @map("payment_reference") @db.VarChar(128)
  notes            String?       @db.VarChar(1000)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([subscriptionId])
  @@map("invoices")
}

/// Enable/disable a licensed module at org / group / institution level. Can never exceed the
/// license (enforced in core/features).
model FeatureOverride {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  scopeType      SettingScopeType @map("scope_type")
  /// organizationId / groupId / institutionId according to scopeType.
  targetId       String           @map("target_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String?          @map("institution_id") @db.Char(36)
  featureKey     String           @map("feature_key") @db.VarChar(64)
  enabled        Boolean
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeType, targetId, featureKey])
  @@index([groupId])
  @@index([institutionId])
  @@map("feature_overrides")
}

/// Usage counter for plan limits. periodKey = 'total' (gauges) or 'YYYY-MM' UTC (monthly).
model UsageCounter {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  limitKey       String   @map("limit_key") @db.VarChar(64)
  periodKey      String   @map("period_key") @db.VarChar(16)
  used           BigInt   @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, limitKey, periodKey])
  @@map("usage_counters")
}

/// Branding per org / group / institution; null fields inherit from the parent level.
model BrandingProfile {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  scopeType      SettingScopeType @map("scope_type")
  targetId       String           @map("target_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String?          @map("institution_id") @db.Char(36)
  displayName    String?          @map("display_name") @db.VarChar(200)
  shortName      String?          @map("short_name") @db.VarChar(50)
  /// Placeholder until the storage engine (Layer 4); see logoFileId.
  logoStorageKey String?          @map("logo_storage_key") @db.VarChar(512)
  /// Future FK to the file/document table (Layer 4).
  logoFileId     String?          @map("logo_file_id") @db.Char(36)
  primaryColor   String?          @map("primary_color") @db.Char(7)
  secondaryColor String?          @map("secondary_color") @db.Char(7)
  accentColor    String?          @map("accent_color") @db.Char(7)
  letterheadText String?          @map("letterhead_text") @db.Text
  footerText     String?          @map("footer_text") @db.VarChar(1000)
  address        String?          @db.VarChar(500)
  contactEmail   String?          @map("contact_email") @db.VarChar(200)
  contactPhone   String?          @map("contact_phone") @db.VarChar(32)
  website        String?          @db.VarChar(300)
  customDomain   String?          @unique @map("custom_domain") @db.VarChar(253)
  subdomain      String?          @unique @db.VarChar(63)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeType, targetId])
  @@index([groupId])
  @@index([institutionId])
  @@map("branding_profiles")
}

/// Envelope-encrypted tenant secret. Hard-deleted (crypto-shredded) — never soft-deleted.
model TenantSecret {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  scopeType      SettingScopeType @map("scope_type")
  targetId       String           @map("target_id") @db.Char(36)
  groupId        String?          @map("group_id") @db.Char(36)
  institutionId  String?          @map("institution_id") @db.Char(36)
  kind           String           @db.VarChar(64)
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(500)
  /// Non-secret configuration (host, sender id, model…).
  metadata       Json?
  /// AES-256-GCM ciphertext of the value under a per-secret data key.
  ciphertext     String           @db.Text
  /// Data key wrapped by the master key (KeyProvider).
  wrappedKey     String           @map("wrapped_key") @db.VarChar(512)
  keyProvider    String           @map("key_provider") @db.VarChar(32)
  keyVersion     Int              @map("key_version")
  last4          String?          @db.VarChar(4)
  fingerprint    String           @db.VarChar(64)
  version        Int              @default(1)
  createdById    String?          @map("created_by_id") @db.Char(36)
  updatedById    String?          @map("updated_by_id") @db.Char(36)
  rotatedAt      DateTime?        @map("rotated_at") @db.DateTime(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeType, targetId, kind, name])
  @@index([organizationId, kind])
  @@index([groupId])
  @@index([institutionId])
  @@index([keyVersion])
  @@map("tenant_secrets")
}
