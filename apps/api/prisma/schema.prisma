enum AttendanceLockStatus {
  LOCKED
  UNLOCKED
}

/// Locked attendance period of an institution: days inside are frozen (no recompute, no
/// override, no regularization, no leave) until explicitly unlocked (`attendance.unlock`).
model AttendancePeriodLock {
  id               String               @id @default(uuid()) @db.Char(36)
  organizationId   String               @map("organization_id") @db.Char(36)
  institutionId    String               @map("institution_id") @db.Char(36)
