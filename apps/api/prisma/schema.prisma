  outpassId        String?  @map("outpass_id") @db.Char(36)
  direction        String   @db.VarChar(4)
  at               DateTime @db.DateTime(3)
  notes            String?  @db.VarChar(300)
  recordedByUserId String?  @map("recorded_by_user_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hostel       Hostel         @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  outpass      HostelOutpass? @relation(fields: [outpassId], references: [id], onDelete: Restrict)

  @@index([organizationId, hostelId, at])
  @@index([organizationId, studentId, at])
  @@map("hostel_movements")
}

