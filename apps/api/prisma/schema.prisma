  lockedByUserId   String?              @map("locked_by_user_id") @db.Char(36)
  lockedAt         DateTime             @default(now()) @map("locked_at") @db.DateTime(3)
  unlockedByUserId String?              @map("unlocked_by_user_id") @db.Char(36)
  unlockedAt       DateTime?            @map("unlocked_at") @db.DateTime(3)
  unlockReason     String?              @map("unlock_reason") @db.VarChar(500)
  createdAt        DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([organizationId, institutionId, status, periodStart])
  @@map("attendance_period_locks")
}

/// Per-institution attendance policy (time zone, late-mark rule, punch channels).
model AttendancePolicy {
  id                  String   @id @default(uuid()) @db.Char(36)
  organizationId      String   @map("organization_id") @db.Char(36)
  institutionId       String   @map("institution_id") @db.Char(36)
  timezone            String   @default("Asia/Kolkata") @db.VarChar(64)
  lateMarksPerHalfDay Int?     @map("late_marks_per_half_day")
  absentIsLop         Boolean  @default(true) @map("absent_is_lop")
