}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
  ON_DUTY
  LOP
}

/// Derived daily attendance (one row per employee per day), recomputed from punches + shift +
/// holidays + approved leave unless the day lies in a locked period. Hierarchy columns are the
/// employee's assignment AS OF `date` (scope filtering + payroll institution attribution).
model AttendanceRecord {
  id               String            @id @default(uuid()) @db.Char(36)
  organizationId   String            @map("organization_id") @db.Char(36)
  employeeId       String            @map("employee_id") @db.Char(36)
  date             DateTime          @db.Date
  groupId          String?           @map("group_id") @db.Char(36)
  institutionId    String            @map("institution_id") @db.Char(36)
  campusId         String?           @map("campus_id") @db.Char(36)
  departmentId     String?           @map("department_id") @db.Char(36)
  shiftId          String?           @map("shift_id") @db.Char(36)
  status           AttendanceStatus
  overrideStatus   AttendanceStatus? @map("override_status")
  overrideReason   String?           @map("override_reason") @db.VarChar(1000)
  firstIn          DateTime?         @map("first_in") @db.DateTime(3)
  lastOut          DateTime?         @map("last_out") @db.DateTime(3)
  workedMinutes    Int               @default(0) @map("worked_minutes")
  lateMinutes      Int               @default(0) @map("late_minutes")
  earlyExitMinutes Int               @default(0) @map("early_exit_minutes")
  overtimeMinutes  Int               @default(0) @map("overtime_minutes")
  isLate           Boolean           @default(false) @map("is_late")
  missingPunch     Boolean           @default(false) @map("missing_punch")
  presentDays      Decimal           @default(0) @map("present_days") @db.Decimal(3, 2)
  paidLeaveDays    Decimal           @default(0) @map("paid_leave_days") @db.Decimal(3, 2)
  unpaidLeaveDays  Decimal           @default(0) @map("unpaid_leave_days") @db.Decimal(3, 2)
  absentDays       Decimal           @default(0) @map("absent_days") @db.Decimal(3, 2)
  offDays          Decimal           @default(0) @map("off_days") @db.Decimal(3, 2)
  leaveTypeId      String?           @map("leave_type_id") @db.Char(36)
  leaveRequestId   String?           @map("leave_request_id") @db.Char(36)
  holidayName      String?           @map("holiday_name") @db.VarChar(200)
  computedAt       DateTime          @map("computed_at") @db.DateTime(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, institutionId, date])
  @@index([organizationId, departmentId, date])
  @@index([organizationId, date, status])
  @@map("attendance_records")
}

enum RegularizationStatus {
