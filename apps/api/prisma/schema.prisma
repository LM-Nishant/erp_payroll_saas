  assetId            String              @map("asset_id") @db.Char(36)
  groupId            String?             @map("group_id") @db.Char(36)
  institutionId      String              @map("institution_id") @db.Char(36)
  campusId           String?             @map("campus_id") @db.Char(36)
  departmentId       String?             @map("department_id") @db.Char(36)
  toGroupId          String?             @map("to_group_id") @db.Char(36)
  toInstitutionId    String              @map("to_institution_id") @db.Char(36)
  toCampusId         String?             @map("to_campus_id") @db.Char(36)
  toDepartmentId     String?             @map("to_department_id") @db.Char(36)
  fromLocation       String?             @map("from_location") @db.VarChar(200)
  toLocation         String?             @map("to_location") @db.VarChar(200)
  reason             String?             @db.VarChar(1000)
  status             AssetTransferStatus @default(PENDING_APPROVAL)
  workflowInstanceId String?             @map("workflow_instance_id") @db.Char(36)
