{
  "name": "erp-payroll-saas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "pnpm --filter @erp/api dev",
    "dev:web": "pnpm --filter @erp/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "db:migrate": "pnpm --filter @erp/api db:migrate",
    "db:deploy": "pnpm --filter @erp/api db:deploy",
    "db:seed": "pnpm --filter @erp/api db:seed",
    "demo:seed": "node scripts/demo/seed-demo.mjs",
    "test:e2e": "pnpm --filter @erp/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
