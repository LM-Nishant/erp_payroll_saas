# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://erp:erp@127.0.0.1:3306/erp
# Used by integration tests (database is reset by the test setup!)
TEST_DATABASE_URL=mysql://erp:erp@127.0.0.1:3306/erp_test
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:5173
# Tenant resolver strategy. `jwt` (default): tenant = organization bound to the access
# token's session. `dev-header`: jwt, plus an all-permissions dev principal when the
# X-Dev-Organization header is sent without a token (dev/test only; rejected when
# NODE_ENV=production). `none` rejects all tenant-scoped requests.
TENANT_RESOLVER=jwt
# Set to the number of proxy hops (or true) behind a load balancer so client IPs are right.
TRUST_PROXY=false

# --- Authentication (both secrets are REQUIRED in production) ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32  (AES-256-GCM key for MFA secrets)
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_ISSUER=Education ERP
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=20
INVITE_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PLATFORM_ACCESS_TTL_MINUTES=30
# Password for the demo users created by `pnpm db:seed` (dev default: Demo-Passw0rd!).
# SEED_DEMO_PASSWORD=
