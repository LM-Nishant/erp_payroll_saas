# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://erp:erp@127.0.0.1:3306/erp
# Used by integration tests (database is reset by the test setup!)
TEST_DATABASE_URL=mysql://erp:erp@127.0.0.1:3306/erp_test
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:5173
# Tenant resolver strategy. `dev-header` trusts X-Dev-Organization-Id and is a
# development stub only (rejected when NODE_ENV=production). `none` rejects all
# tenant-scoped requests until the auth layer provides a principal-based resolver.
TENANT_RESOLVER=dev-header
