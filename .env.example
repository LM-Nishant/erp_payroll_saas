# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://erp:erp@127.0.0.1:3306/erp
# Used by integration tests (database is reset by the test setup!)
TEST_DATABASE_URL=mysql://erp:erp@127.0.0.1:3306/erp_test
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:5173
# Tenant resolver strategy. `jwt` (default): tenant = organization bound to the access
# token's session. `dev-header`: jwt, plus an all-permissions dev principal when the
# X-Dev-Organization header is sent without a token (dev/test only; rejected when
# NODE_ENV=production). `none` rejects all tenant-scoped requests.
TENANT_RESOLVER=jwt
# Set to the number of proxy hops (or true) behind a load balancer so client IPs are right.
TRUST_PROXY=false

# --- Authentication (both secrets are REQUIRED in production) ---
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32  (AES-256-GCM key for MFA secrets)
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_ISSUER=Education ERP
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=20
INVITE_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PLATFORM_ACCESS_TTL_MINUTES=30

# --- Secret management (core/secrets) — SECRETS_MASTER_KEYS is REQUIRED in production ---
# Master keys that wrap per-secret data keys: comma-separated `<version>:<base64 32 bytes>`.
# Rotate by ADDING a new version (keep old ones until `POST /platform/secrets/rewrap` ran).
# Generate a key with: openssl rand -base64 32
# SECRETS_MASTER_KEYS=1:<base64>,2:<base64>
# Version that wraps new data keys (default: highest configured version).
# SECRETS_ACTIVE_KEY_VERSION=2
SECRETS_KEY_PROVIDER=local

# Password for the demo users created by `pnpm db:seed` (dev default: Demo-Passw0rd!).
# SEED_DEMO_PASSWORD=

# --- File storage (core/storage) ---
# s3 (production) | local (filesystem, dev) | memory (tests only; refused in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# HMAC key for local signed URLs (REQUIRED in production when STORAGE_DRIVER=local)
# STORAGE_LOCAL_SIGNING_SECRET=
# Public origin of the API used in local signed URLs (empty = relative URLs)
# STORAGE_PUBLIC_BASE_URL=http://localhost:3000
# Private bucket with default encryption + versioning enabled; credentials default to the
# AWS SDK chain (IAM role). Per-organization buckets can be configured as a `storage` secret.
# STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SSE=AES256
# STORAGE_S3_KMS_KEY_ID=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_BYTES=26214400
DOCUMENT_RETENTION_DAYS=30

# --- Queue, communication & integrations (Layer 5) ---
# bullmq (Redis; run `pnpm --filter @erp/api worker`) | inline (in-process; tests / Redis-less dev)
# Default: inline under NODE_ENV=test, bullmq otherwise.
# QUEUE_DRIVER=bullmq
QUEUE_CONCURRENCY=5
# memory | redis (share auth rate-limit counters across API instances)
RATE_LIMIT_STORE=memory
# Public origins used in email links / delivery-callback URLs
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# Platform fallback mailer for system emails (invites, password resets) when a tenant has no
# email provider: log (outbox only, dev/test) | smtp (SMTP_URL, e.g. smtp://user:pass@host:587)
MAIL_DRIVER=log
# SMTP_URL=
MAIL_FROM=Education ERP <no-reply@erp.local>
OUTBOUND_HTTP_TIMEOUT_MS=10000
# Allow http:// and private-network webhook targets (dev only; refused in production)
# WEBHOOK_ALLOW_INSECURE=true
API_CLIENT_TOKEN_TTL_SECONDS=3600
